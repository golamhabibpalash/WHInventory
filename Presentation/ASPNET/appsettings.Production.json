{
  // Production overrides. The base appsettings.json ships developer-friendly defaults that are
  // unsafe in production; this file flips them. Real secrets (Jwt:Key, DB connection, SMTP,
  // AspNetIdentity:DefaultAdmin:Password) must still be supplied via environment variables or a
  // secret store — the startup guard in BackEndConfiguration refuses to boot otherwise.

  // Never seed demo/sample data into a real tenant's database.
  "IsDemoVersion": false,

  // Disable open self-service organisation creation unless it is genuinely wanted.
  "AllowPublicTenantSignUp": false
}
