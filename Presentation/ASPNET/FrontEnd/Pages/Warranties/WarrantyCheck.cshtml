@page
@{
    ViewData["Title"] = "Warranty Check";
}

@section styles {
<style>
    /* Product dropdown rows: code badge alongside the product name */
    .wc-product-item {
        display: flex;
        align-items: center;
        gap: .6rem;
        min-width: 0;
    }
    .wc-product-code {
        flex-shrink: 0;
        font-size: .7rem;
        font-weight: 700;
        color: #3b82f6;
        background: #eef4ff;
        border: 1px solid #dbe6ff;
        border-radius: 5px;
        padding: .1rem .4rem;
        white-space: nowrap;
    }
    .wc-product-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>
}

<div id="app" v-cloak>
    <div class="row mb-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-shield-alt me-2 text-primary"></i>Warranty Check</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label>Customer</label>
                            <div ref="customerIdRef"></div>
                        </div>
                        <div class="col-md-4">
                            <label>Product</label>
                            <div ref="productIdRef"></div>
                        </div>
                        <div class="col-md-2">
                            <label>Claim Date <span class="text-danger">*</span></label>
                            <input ref="claimDateRef">
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button type="button"
                                    class="btn btn-primary w-100"
                                    v-on:click="handler.search"
                                    v-bind:disabled="state.isSearching">
                                <span class="spinner-border spinner-border-sm me-1" v-if="state.isSearching"></span>
                                <i class="fas fa-search me-1" v-else></i>
                                {{ state.isSearching ? 'Searching...' : 'Search' }}
                            </button>
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    v-on:click="handler.reset"
                                    title="Reset filters">
                                <i class="fas fa-undo"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef" id="MainGrid"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Warranties/WarrantyCheck.cshtml.js"></script>
}
