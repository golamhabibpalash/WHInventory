@page
@{
    ViewData["Title"] = "Inbound Report";
}

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <p class="text-muted mb-2" style="font-size:.85rem;">
                All confirmed inbound (goods receive, sales return, transfer in, positive adjustment)
                transactions &mdash; {{ state.scopeLabel }}.
            </p>
            <div class="grid-container">
                <div ref="mainGridRef" id="MainGrid"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/StockReports/InboundReportList.cshtml.js"></script>
}
