@page
@{
    ViewData["Title"] = "Low Stock Report";
}

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <p class="text-muted mb-2" style="font-size:.85rem;">
                Physical products at or below {{ state.thresholdLabel }} units on hand &mdash; {{ state.scopeLabel }}.
            </p>
            <div class="grid-container">
                <div ref="mainGridRef" id="MainGrid"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/StockReports/LowStockReportList.cshtml.js"></script>
}
