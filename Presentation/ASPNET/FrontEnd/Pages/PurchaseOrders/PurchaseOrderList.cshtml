@page
@{
    ViewData["Title"] = "Purchase Order List";
}

@section styles {
    <link rel="stylesheet" href="~/css/pos-order-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/order-view-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/purchase-order-list.css" asp-append-version="true" />
}

<div id="app" v-cloak>
    <div class="po-page-header">
        <h1 class="po-page-title">Purchase Orders</h1>
        <p class="po-page-subtitle">Review, filter, and manage every purchase order</p>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="grid-container po-grid-wrap">
                <!-- Filter panel — toggled by the Filter button in the grid toolbar. Live filtering:
                     each control change re-filters the list instantly (no Apply button needed). -->
                <div ref="filterPanelRef" class="po-filter-panel" v-show="state.filterOpen" role="region" aria-label="Purchase order filters">
                    <div class="po-filter-panel__header">
                        <span class="po-filter-panel__title">
                            <i class="fas fa-filter"></i>Filters
                            <span class="po-filter-panel__count" v-if="activeFilterCount">{{ activeFilterCount }}</span>
                        </span>
                        <div class="po-filter-panel__header-actions">
                            <button type="button" class="btn btn-sm btn-link po-filter-clear" v-on:click="handler.clearFilters" v-bind:disabled="!activeFilterCount">
                                <i class="fas fa-times-circle"></i><span>Clear all</span>
                            </button>
                            <button type="button" class="btn-close po-filter-close" aria-label="Close filters" v-on:click="handler.toggleFilter"></button>
                        </div>
                    </div>
                    <div class="po-filter-panel__body">
                        <div class="po-filter-field">
                            <label class="po-filter-label">Status</label>
                            <div ref="filterStatusRef"></div>
                        </div>
                        <div class="po-filter-field">
                            <label class="po-filter-label">Vendor</label>
                            <div ref="filterVendorRef"></div>
                        </div>
                        <div class="po-filter-field">
                            <label class="po-filter-label">Tax</label>
                            <div ref="filterTaxRef"></div>
                        </div>
                        <div class="po-filter-field">
                            <label class="po-filter-label">Created From</label>
                            <div ref="filterFromDateRef"></div>
                        </div>
                        <div class="po-filter-field">
                            <label class="po-filter-label">Created To</label>
                            <div ref="filterToDateRef"></div>
                        </div>
                    </div>
                </div>

                <div ref="mainGridRef" id="MainGrid"></div>
            </div>
        </div>
    </div>

    <div class="modal fade pos-modal" ref="mainModalRef" id="MainModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content" v-on:keydown="handler.onModalKeydown">
                <div class="modal-header pos-header">
                    <div class="pos-header-title">
                        <span class="pos-header-icon" v-bind:class="{ 'is-danger': state.deleteMode }">
                            <i v-bind:class="state.deleteMode ? 'fas fa-trash' : 'fas fa-truck-loading'"></i>
                        </span>
                        <div>
                            <h5 class="modal-title">{{ state.mainTitle }}</h5>
                            <div class="pos-header-meta">
                                <span v-if="state.number">{{ state.number }}</span>
                                <span v-else>Number is assigned when the first item is added</span>
                                <span class="pos-dot" v-if="state.secondaryData.length"></span>
                                <span v-if="state.secondaryData.length">{{ state.secondaryData.length }} item(s)</span>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" tabindex="-1"></button>
                </div>
                <div class="modal-body pos-body">
                    <input type="hidden" v-model="state.id" id="Id" name="Id" />

                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" v-if="state.deleteMode">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>You are about to delete Purchase Order <strong>{{ state.number }}</strong><span v-if="state.vendor.name"> from <strong>{{ state.vendor.name }}</strong></span> and its {{ state.secondaryData.length }} line item(s). This cannot be undone.</span>
                    </div>

                    <div class="row g-3">
                        <!-- LEFT: vendor, product entry, cart, order details (DOM order = tab order) -->
                        <div class="col-lg-8" v-show="!state.deleteMode">
                            <section class="card pos-section pos-customer" aria-labelledby="VendorSectionTitle">
                                <div class="card-body">
                                    <div class="pos-customer-grid">
                                        <div class="pos-combo">
                                            <label for="VendorSearch" id="VendorSectionTitle" class="pos-field-label">Vendor<span class="pos-req">*</span></label>
                                            <div class="pos-field-with-action">
                                                <div class="pos-combo-input">
                                                    <i class="fas fa-store pos-combo-icon" aria-hidden="true"></i>
                                                    <input ref="vendorInputRef"
                                                           id="VendorSearch"
                                                           type="text"
                                                           class="form-control"
                                                           v-bind:class="{ 'is-invalid': state.errors.vendorId }"
                                                           placeholder="Search vendor by name or phone"
                                                           autocomplete="off"
                                                           role="combobox"
                                                           aria-autocomplete="list"
                                                           aria-controls="VendorSuggestions"
                                                           v-bind:aria-expanded="state.vendor.open ? 'true' : 'false'"
                                                           v-bind:aria-activedescendant="state.vendor.open && state.vendor.activeIndex >= 0 ? 'VendorOption' + state.vendor.activeIndex : null"
                                                           v-model="state.vendor.input"
                                                           v-on:input="handler.vendorInput"
                                                           v-on:keydown="handler.vendorKeydown"
                                                           v-on:focus="handler.vendorFocus"
                                                           v-on:blur="handler.vendorBlur" />
                                                </div>
                                                <button type="button"
                                                        class="btn btn-outline-success pos-icon-btn"
                                                        tabindex="-1"
                                                        v-on:click="handler.openVendorQuickCreate"
                                                        v-bind:disabled="state.deleteMode"
                                                        title="Quick-create a new vendor"
                                                        aria-label="Quick-create a new vendor">
                                                    <i class="fas fa-plus"></i>
                                                </button>
                                            </div>
                                            <ul class="pos-combo-list" id="VendorSuggestions" role="listbox" aria-label="Matching vendors" v-show="state.vendor.open">
                                                <li v-for="(v, index) in state.vendor.suggestions"
                                                    v-bind:key="v.id"
                                                    v-bind:id="'VendorOption' + index"
                                                    role="option"
                                                    class="pos-combo-option"
                                                    v-bind:class="{ 'is-active': index === state.vendor.activeIndex }"
                                                    v-bind:aria-selected="index === state.vendor.activeIndex ? 'true' : 'false'"
                                                    v-on:mousedown.prevent="handler.selectVendor(v)"
                                                    v-on:mousemove="state.vendor.activeIndex = index">
                                                    <span class="pos-combo-main">{{ v.name || '—' }}</span>
                                                    <span class="pos-combo-meta">{{ v.phoneNumber || 'No phone' }}</span>
                                                </li>
                                            </ul>
                                            <div class="pos-field-error" v-if="state.errors.vendorId" role="alert">{{ state.errors.vendorId }}</div>
                                        </div>

                                        <div class="pos-customer-status" aria-live="polite">
                                            <div class="pos-customer-card is-existing" v-if="state.vendor.id">
                                                <span class="pos-customer-avatar"><i class="fas fa-store"></i></span>
                                                <div class="pos-customer-text">
                                                    <div class="pos-customer-name">{{ state.vendor.name || 'Vendor' }}</div>
                                                    <div class="pos-customer-sub">
                                                        <span v-if="state.vendor.number">{{ state.vendor.number }}</span>
                                                        <span v-if="state.vendor.phoneNumber">{{ state.vendor.phoneNumber }}</span>
                                                    </div>
                                                </div>
                                                <button type="button" class="pos-link-btn" tabindex="-1" v-on:click="handler.clearVendor" title="Change vendor" aria-label="Change vendor">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                            <p class="pos-note" v-else-if="state.vendor.open && !state.vendor.suggestions.length">No vendor matches. Use <i class="fas fa-plus"></i> to add one.</p>
                                            <p class="pos-note" v-else-if="!state.errors.vendorId">Search for a vendor by name or phone, or add a new one.</p>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section class="card pos-section pos-card" aria-labelledby="ProductSectionTitle">
                                <div class="card-header">
                                    <h6 class="pos-section-title" id="ProductSectionTitle"><i class="fas fa-box-open"></i>Add Products</h6>
                                    <span class="pos-kbd-hint d-none d-md-inline">Enter to pick &middot; Enter again to add &middot; Esc to clear</span>
                                </div>
                                <div class="card-body pos-pick">
                                    <div class="pos-combo">
                                        <label for="ProductSearch" class="pos-field-label">Product</label>
                                        <div class="pos-combo-input">
                                            <i class="fas fa-search pos-combo-icon" aria-hidden="true"></i>
                                            <input ref="productSearchRef"
                                                   id="ProductSearch"
                                                   type="text"
                                                   class="form-control"
                                                   placeholder="Search by name or SKU, or scan a barcode"
                                                   autocomplete="off"
                                                   role="combobox"
                                                   aria-autocomplete="list"
                                                   aria-controls="ProductSuggestions"
                                                   v-bind:aria-expanded="state.productSearch.open && productMatches.length ? 'true' : 'false'"
                                                   v-bind:aria-activedescendant="state.productSearch.open && productMatches.length ? 'ProductOption' + state.productSearch.activeIndex : null"
                                                   v-model="state.productSearch.term"
                                                   v-on:input="handler.productInput"
                                                   v-on:keydown="handler.productKeydown"
                                                   v-on:blur="handler.productBlur" />
                                            <span class="pos-combo-spinner" v-if="state.isAddingLine" aria-hidden="true">
                                                <i class="fas fa-spinner fa-spin"></i>
                                            </span>
                                        </div>
                                        <ul class="pos-combo-list" id="ProductSuggestions" role="listbox" aria-label="Matching products" v-show="state.productSearch.open && productMatches.length">
                                            <li v-for="(p, index) in productMatches"
                                                v-bind:key="p.id"
                                                v-bind:id="'ProductOption' + index"
                                                role="option"
                                                class="pos-combo-option"
                                                v-bind:class="{ 'is-active': index === state.productSearch.activeIndex }"
                                                v-bind:aria-selected="index === state.productSearch.activeIndex ? 'true' : 'false'"
                                                v-on:mousedown.prevent="handler.pickProduct(p)"
                                                v-on:mousemove="state.productSearch.activeIndex = index">
                                                <span class="pos-combo-main">{{ p.name }}</span>
                                                <span class="pos-combo-meta">{{ p.number }}</span>
                                            </li>
                                        </ul>
                                    </div>

                                    <div class="pos-entry mt-3">
                                        <div>
                                            <label for="PickUnitCost" class="pos-field-label">Unit Cost</label>
                                            <input ref="pickPriceRef" id="PickUnitCost" type="number" step="0.01" min="0"
                                                   class="form-control text-end"
                                                   v-bind:disabled="!state.productPick.productId"
                                                   v-model.number="state.productPick.unitPrice"
                                                   v-on:keydown.enter.exact.prevent="handler.addLineToCart">
                                        </div>
                                        <div>
                                            <label for="PickCommission" class="pos-field-label">Commission %</label>
                                            <input id="PickCommission" type="number" step="0.01" min="0" max="100"
                                                   class="form-control text-end"
                                                   title="Commission as a percentage of unit cost"
                                                   v-bind:disabled="!state.productPick.productId"
                                                   v-model.number="state.productPick.commission"
                                                   v-on:keydown.enter.exact.prevent="handler.addLineToCart">
                                        </div>
                                        <div>
                                            <label for="PickQuantity" class="pos-field-label">Quantity</label>
                                            <div class="input-group pos-qty">
                                                <div class="input-group-prepend">
                                                    <button type="button" class="btn btn-outline-secondary" tabindex="-1" v-on:click="handler.stepQty(-1)" v-bind:disabled="!state.productPick.productId" aria-label="Decrease quantity"><i class="fas fa-minus"></i></button>
                                                </div>
                                                <input ref="pickQtyRef" id="PickQuantity" type="number" step="any" min="0" class="form-control"
                                                       v-bind:disabled="!state.productPick.productId"
                                                       v-model.number="state.productPick.quantity"
                                                       v-on:keydown.enter.exact.prevent="handler.addLineToCart">
                                                <div class="input-group-append">
                                                    <button type="button" class="btn btn-outline-secondary" tabindex="-1" v-on:click="handler.stepQty(1)" v-bind:disabled="!state.productPick.productId" aria-label="Increase quantity"><i class="fas fa-plus"></i></button>
                                                </div>
                                            </div>
                                        </div>
                                        <div>
                                            <span class="pos-field-label">Line Total</span>
                                            <div class="pos-calc" aria-live="polite">{{ handler.formatAmount(posLineTotal) }}</div>
                                        </div>
                                        <button type="button" class="btn btn-primary pos-add-btn"
                                                v-on:click="handler.addLineToCart"
                                                v-bind:disabled="state.isAddingLine || !state.productPick.productId">
                                            <span class="spinner-border spinner-border-sm me-2" v-if="state.isAddingLine" role="status" aria-hidden="true"></span>
                                            <i class="fas fa-cart-plus me-2" v-else></i>Add
                                        </button>
                                    </div>

                                    <div class="pos-field-error mt-2" v-if="state.pickError" role="alert">{{ state.pickError }}</div>

                                    <div class="pos-hints" v-if="state.productHint.name">
                                        <span class="pos-hint" title="Product code"><i class="fas fa-hashtag"></i>{{ state.productHint.number || '—' }}</span>
                                    </div>
                                </div>
                            </section>

                            <section class="card pos-section pos-card pos-cart-card mb-0" aria-labelledby="CartSectionTitle">
                                <div class="card-header">
                                    <h6 class="pos-section-title" id="CartSectionTitle"><i class="fas fa-shopping-cart"></i>Cart <span class="pos-count">{{ state.secondaryData.length }}</span></h6>
                                    <span class="pos-flash" role="status" aria-live="polite">
                                        <span v-if="state.cartFlash"><i class="fas fa-check-circle me-1"></i>{{ state.cartFlash }}</span>
                                    </span>
                                    <button type="button" class="pos-link-btn is-danger" tabindex="-1"
                                            v-on:click="handler.clearCart"
                                            v-bind:disabled="!state.secondaryData.length">
                                        <i class="fas fa-trash-alt me-1"></i>Clear all
                                    </button>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive pos-cart-scroll">
                                        <table class="table pos-cart">
                                            <thead>
                                                <tr>
                                                    <th>Product</th>
                                                    <th class="text-center pos-col-qty">Qty</th>
                                                    <th class="text-end pos-col-price">Unit Cost</th>
                                                    <th class="text-end pos-col-comm">Comm %</th>
                                                    <th class="text-end pos-col-amount">Discount</th>
                                                    <th class="text-end pos-col-amount">Total</th>
                                                    <th class="pos-col-action"><span class="sr-only">Remove</span></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr v-if="!state.secondaryData.length">
                                                    <td colspan="7">
                                                        <div class="pos-empty">
                                                            <i class="fas fa-shopping-basket"></i>
                                                            <strong>Your cart is empty</strong>
                                                            <span>Search for a product or scan a barcode to add it.</span>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr v-for="line in state.secondaryData" v-bind:key="line.id">
                                                    <td>
                                                        <div class="pos-cart-product">{{ line.productName }}</div>
                                                        <div class="pos-cart-sku">{{ line.productNumber }}</div>
                                                    </td>
                                                    <td>
                                                        <div class="input-group input-group-sm pos-qty">
                                                            <div class="input-group-prepend">
                                                                <button type="button" class="btn btn-outline-secondary" tabindex="-1" v-on:click="handler.stepLineQty(line, -1)" aria-label="Decrease quantity"><i class="fas fa-minus"></i></button>
                                                            </div>
                                                            <input type="number" step="any" min="0" class="form-control"
                                                                   v-bind:aria-label="'Quantity of ' + line.productName"
                                                                   v-bind:value="line.quantity"
                                                                   v-on:change="handler.commitLineQty(line, $event.target.value)">
                                                            <div class="input-group-append">
                                                                <button type="button" class="btn btn-outline-secondary" tabindex="-1" v-on:click="handler.stepLineQty(line, 1)" aria-label="Increase quantity"><i class="fas fa-plus"></i></button>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="text-end">
                                                        <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end pos-line-price"
                                                               v-bind:aria-label="'Unit cost of ' + line.productName"
                                                               v-bind:value="line.unitPrice"
                                                               v-on:change="handler.commitLinePrice(line, $event.target.value)">
                                                    </td>
                                                    <td class="text-end">
                                                        <input type="number" step="0.01" min="0" max="100" class="form-control form-control-sm text-end pos-line-price"
                                                               v-bind:aria-label="'Commission percent of ' + line.productName"
                                                               title="Commission percent of unit cost"
                                                               v-bind:value="line.commissionRate"
                                                               v-on:change="handler.commitLineCommission(line, $event.target.value)">
                                                    </td>
                                                    <td class="text-end">{{ handler.formatAmount((line.unitPrice || 0) * (line.quantity || 0) * (line.commissionRate || 0) / 100) }}</td>
                                                    <td class="text-end fw-semibold">{{ handler.formatAmount((line.unitPrice || 0) * (1 - (line.commissionRate || 0) / 100) * (line.quantity || 0)) }}</td>
                                                    <td class="text-center">
                                                        <button type="button" class="pos-remove-btn" v-on:click="handler.removeLine(line)" v-bind:title="'Remove ' + line.productName" v-bind:aria-label="'Remove ' + line.productName">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </section>

                            <!-- Order details (always rendered so the Syncfusion inputs keep their host nodes) -->
                            <form id="MainForm" class="card pos-section mb-0 mt-3" v-on:submit.prevent aria-labelledby="DetailsSectionTitle">
                                <div class="card-header">
                                    <h6 class="pos-section-title" id="DetailsSectionTitle"><i class="fas fa-file-alt"></i>Order Details</h6>
                                </div>
                                <div class="card-body">
                                    <div class="pos-details">
                                        <div>
                                            <label for="OrderDate" class="pos-field-label">Order Date<span class="pos-req">*</span></label>
                                            <input ref="orderDateRef" id="OrderDate" />
                                            <div class="pos-field-error" v-if="state.errors.orderDate" role="alert">{{ state.errors.orderDate }}</div>
                                        </div>
                                        <div>
                                            <label for="OrderStatus" class="pos-field-label">Status<span class="pos-req">*</span></label>
                                            <div ref="orderStatusRef" id="OrderStatus"></div>
                                            <div class="pos-field-error" v-if="state.errors.orderStatus" role="alert">{{ state.errors.orderStatus }}</div>
                                        </div>
                                        <div>
                                            <label for="TaxId" class="pos-field-label">Tax<span class="pos-req">*</span></label>
                                            <div class="pos-field-with-action">
                                                <div ref="taxIdRef" id="TaxId"></div>
                                                <button type="button"
                                                        class="btn btn-outline-primary pos-icon-btn"
                                                        tabindex="-1"
                                                        v-on:click="handler.openTaxQuickCreate"
                                                        v-bind:disabled="state.deleteMode"
                                                        title="Quick-create a new tax"
                                                        aria-label="Quick-create a new tax">
                                                    <i class="fas fa-plus"></i>
                                                </button>
                                            </div>
                                            <div class="pos-field-error" v-if="state.errors.taxId" role="alert">{{ state.errors.taxId }}</div>
                                        </div>
                                        <div>
                                            <label for="ReferenceNumber" class="pos-field-label">Reference Number</label>
                                            <input id="ReferenceNumber" type="text" class="form-control" v-model="state.referenceNumber" placeholder="e.g. Invoice #, PO Ref">
                                        </div>
                                        <div class="pos-span-all">
                                            <label for="Description" class="pos-field-label">Note</label>
                                            <textarea id="Description" class="form-control" rows="1" v-model="state.description" placeholder="Optional note for this order"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <!-- RIGHT: totals and payments -->
                        <div class="col-lg-4" v-show="!state.deleteMode">
                            <div class="pos-side">
                                <section class="card pos-section" aria-labelledby="SummarySectionTitle">
                                    <div class="card-body">
                                        <h6 class="sr-only" id="SummarySectionTitle">Summary</h6>
                                        <div class="pos-total-block mt-0">
                                            <div class="pos-total-label">Total</div>
                                            <div class="pos-total-value" id="TotalAmount">{{ state.totalAmount }}</div>
                                            <div class="pos-total-words" id="AmountInWords" v-if="state.amountInWords">{{ state.amountInWords }}</div>
                                        </div>
                                        <div class="pos-summary-row">
                                            <span class="text-muted">Subtotal</span>
                                            <span id="SubTotalAmount">{{ state.subTotalAmount }}</span>
                                        </div>
                                        <div class="pos-summary-row">
                                            <span class="text-muted">Discount (commission)</span>
                                            <span id="DiscountAmount">&minus;{{ state.discountAmount }}</span>
                                        </div>
                                        <div class="pos-summary-row">
                                            <span class="text-muted">Tax</span>
                                            <span id="TaxAmount">{{ state.taxAmount }}</span>
                                        </div>
                                        <div class="pos-summary-row" v-if="state.paymentSummary">
                                            <span class="text-muted">Paid</span>
                                            <span id="AmountPaid">{{ handler.formatAmount(state.paymentSummary.amountPaid) }}</span>
                                        </div>
                                        <div class="pos-balance" v-if="state.paymentSummary"
                                             v-bind:class="state.isFullySettled ? 'is-settled' : 'is-due'">
                                            <span><i class="fas me-2" v-bind:class="state.isFullySettled ? 'fa-check-circle' : 'fa-clock'"></i>{{ state.isFullySettled ? 'Fully settled' : 'Balance due' }}</span>
                                            <span id="AmountOutstanding">{{ handler.formatAmount(state.paymentSummary.amountOutstanding) }}</span>
                                        </div>
                                    </div>
                                </section>

                                <section class="card pos-section mb-0" aria-labelledby="PaymentSectionTitle">
                                    <div class="card-header">
                                        <h6 class="pos-section-title" id="PaymentSectionTitle"><i class="fas fa-hand-holding-usd"></i>Payments <span class="pos-count" v-if="state.paymentList.length">{{ state.paymentList.length }}</span></h6>
                                    </div>
                                    <div class="card-body">
                                        <p class="pos-note" v-if="!state.id">
                                            Payments to the vendor can be recorded once the first item is added.
                                        </p>

                                        <ul class="pos-pay-list" v-if="state.paymentList.length">
                                            <li class="pos-pay-item" v-for="p in state.paymentList" v-bind:key="p.id">
                                                <div class="pos-pay-main">
                                                    <div class="pos-pay-method">{{ p.paymentMethodName }}</div>
                                                    <div class="pos-pay-date">{{ handler.formatPaymentDate(p.paymentDate) }}</div>
                                                </div>
                                                <span class="pos-pay-amount">{{ handler.formatAmount(p.amount) }}</span>
                                                <button type="button"
                                                        class="pos-remove-btn"
                                                        tabindex="-1"
                                                        v-on:click="handler.deletePayment(p)"
                                                        v-bind:disabled="state.deleteMode || state.isPaymentSubmitting"
                                                        title="Remove this payment"
                                                        aria-label="Remove this payment">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </li>
                                        </ul>
                                        <p class="pos-note mb-3" v-else-if="state.id">No payments recorded yet.</p>

                                        <div v-if="!state.deleteMode && state.id && !state.isFullySettled">
                                            <div class="pos-pay-form">
                                                <div>
                                                    <label for="PaymentAmount" class="pos-field-label">Amount</label>
                                                    <input ref="paymentAmountRef" id="PaymentAmount" type="number" step="0.01" min="0" class="form-control text-end"
                                                           v-model.number="state.newPayment.amount"
                                                           v-bind:placeholder="handler.formatAmount(state.paymentSummary ? state.paymentSummary.amountOutstanding : 0)"
                                                           v-on:keydown.enter.exact.prevent="handler.paymentAmountEnter">
                                                </div>
                                                <div>
                                                    <label for="PaymentMethod" class="pos-field-label">Method</label>
                                                    <select id="PaymentMethod" class="form-select" v-model="state.newPayment.paymentMethodId">
                                                        <option value="">Select...</option>
                                                        <option v-for="m in state.paymentMethodListLookupData" v-bind:key="m.id" v-bind:value="m.id">{{ m.name }}</option>
                                                    </select>
                                                </div>
                                                <div>
                                                    <label class="pos-field-label">Date</label>
                                                    <input ref="paymentDateRef">
                                                </div>
                                                <div>
                                                    <label for="PaymentReference" class="pos-field-label">Reference</label>
                                                    <input id="PaymentReference" type="text" class="form-control" v-model="state.newPayment.referenceNumber" placeholder="Optional"
                                                           v-on:keydown.enter.exact.prevent="handler.submitPayment">
                                                </div>
                                            </div>
                                            <div class="pos-pay-actions">
                                                <button type="button" class="btn btn-success"
                                                        v-on:click="handler.submitPayment"
                                                        v-bind:disabled="state.isPaymentSubmitting">
                                                    <span class="spinner-border spinner-border-sm me-2" v-if="state.isPaymentSubmitting" role="status" aria-hidden="true"></span>
                                                    <i class="fas fa-check me-2" v-else></i>Record Payment
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary"
                                                        v-on:click="handler.payFullBalance"
                                                        v-bind:disabled="state.isPaymentSubmitting"
                                                        title="Fill the amount with the outstanding balance">
                                                    Pay full balance
                                                </button>
                                            </div>
                                        </div>
                                        <p class="pos-note is-danger mt-2" v-if="state.paymentError" role="alert">{{ state.paymentError }}</p>
                                        <p class="pos-note is-success" v-if="state.isFullySettled"><i class="fas fa-check-circle me-2"></i>This order is fully settled.</p>
                                    </div>
                                </section>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer pos-footer">
                    <div class="pos-footer-summary" v-if="!state.deleteMode">
                        {{ state.secondaryData.length }} item(s) &middot; Total <strong>{{ state.totalAmount }}</strong>
                        <span class="pos-kbd-hint d-none d-md-inline ms-2"><kbd>Ctrl</kbd>+<kbd>Enter</kbd> to save</span>
                    </div>
                    <div class="pos-footer-actions">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button"
                                id="MainReceiveNowButton"
                                class="btn btn-success"
                                v-if="!state.deleteMode"
                                title="Save the purchase order and receive all remaining quantities"
                                v-on:click="handler.receiveNow"
                                v-bind:disabled="state.isReceiving || state.isSubmitting"
                                v-bind:aria-busy="state.isReceiving ? 'true' : 'false'">
                            <span class="spinner-border spinner-border-sm me-2" v-if="state.isReceiving" role="status" aria-hidden="true"></span>
                            <i v-if="!state.isReceiving" class="fas fa-truck me-2"></i><span v-if="!state.isReceiving">Receive Now</span>
                            <span v-else>Receiving...</span>
                        </button>
                        <button type="button"
                                ref="saveButtonRef"
                                id="MainSaveButton"
                                class="btn"
                                v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                                v-on:click="handler.handleSubmit"
                                v-bind:disabled="state.isSubmitting || state.isReceiving"
                                v-bind:aria-busy="state.isSubmitting ? 'true' : 'false'">
                            <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                            <i v-if="!state.isSubmitting" v-bind:class="state.deleteMode ? 'fas fa-trash me-2' : 'fas fa-save me-2'"></i><span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Delete Order' : 'Save Order' }}</span>
                            <span v-else>{{ state.deleteMode ? 'Deleting...' : 'Saving...' }}</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

