@page
@{
    ViewData["Title"] = "Purchase Order List";
}

@section styles {
    <link rel="stylesheet" href="~/css/pos-order-modal.css" asp-append-version="true" />
}

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef" id="MainGrid"></div>
            </div>
        </div>
    </div>

    <div class="modal fade pos-modal" ref="mainModalRef" id="MainModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-truck-loading me-2 text-primary"></i>{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" v-model="state.id" id="Id" name="Id" />

                    <!-- Order-detail bar (always rendered so the Syncfusion inputs keep their host nodes) -->
                    <form id="MainForm" class="card pos-orderbar mb-3">
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label for="VendorId" class="form-label">Vendor <span class="text-danger">*</span></label>
                                    <div class="d-flex align-items-center gap-2">
                                        <div ref="vendorIdRef" class="flex-grow-1"></div>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-success flex-shrink-0"
                                                v-on:click="handler.openVendorQuickCreate"
                                                v-bind:disabled="state.deleteMode"
                                                title="Quick-create a new vendor">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                    <div class="text-danger small mt-1" v-if="state.errors.vendorId">{{ state.errors.vendorId }}</div>
                                </div>
                                <div class="col-md-2">
                                    <label for="OrderDate" class="form-label">Order Date</label>
                                    <input ref="orderDateRef" />
                                    <div class="text-danger small mt-1" v-if="state.errors.orderDate">{{ state.errors.orderDate }}</div>
                                </div>
                                <div class="col-md-2">
                                    <label for="Number" class="form-label">Number</label>
                                    <input ref="numberRef" v-model="state.number" readonly>
                                </div>
                                <div class="col-md-3">
                                    <label for="TaxId" class="form-label">Tax <span class="text-danger">*</span></label>
                                    <div class="d-flex align-items-center gap-2">
                                        <div ref="taxIdRef" class="flex-grow-1"></div>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary flex-shrink-0"
                                                v-on:click="handler.openTaxQuickCreate"
                                                v-bind:disabled="state.deleteMode"
                                                title="Quick-create a new tax">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                    <div class="text-danger small mt-1" v-if="state.errors.taxId">{{ state.errors.taxId }}</div>
                                </div>
                                <div class="col-md-2">
                                    <label for="OrderStatus" class="form-label">Status <span class="text-danger">*</span></label>
                                    <div ref="orderStatusRef"></div>
                                    <div class="text-danger small mt-1" v-if="state.errors.orderStatus">{{ state.errors.orderStatus }}</div>
                                </div>
                                <div class="col-12">
                                    <label for="Description" class="form-label">Description</label>
                                    <textarea class="form-control" rows="1" v-model="state.description"></textarea>
                                </div>
                                <div class="col-md-4">
                                    <label for="ReferenceNumber" class="form-label">Reference Number</label>
                                    <input type="text" class="form-control" v-model="state.referenceNumber" placeholder="e.g. Invoice #, PO Ref">
                                </div>
                            </div>
                        </div>
                    </form>

                    <div class="alert alert-danger d-flex align-items-center gap-2" v-if="state.deleteMode">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>You are about to delete Purchase Order <strong>{{ state.number }}</strong> and its {{ state.secondaryData.length }} line item(s). This cannot be undone.</span>
                    </div>

                    <!-- POS working area -->
                    <div class="row g-3" v-show="!state.deleteMode">
                        <!-- LEFT: product picker + cart -->
                        <div class="col-lg-7">
                            <div class="card pos-card mb-3">
                                <div class="card-header">
                                    <h6><i class="fas fa-box-open me-2"></i>Select Product</h6>
                                </div>
                                <div class="card-body pos-pick">
                                    <div class="mb-3">
                                        <label class="form-label">Product</label>
                                        <div ref="productPickRef"></div>
                                    </div>
                                    <div class="row g-3 align-items-end mb-2">
                                        <div class="col-4">
                                            <label class="form-label">Unit Cost</label>
                                            <input type="number" step="0.01" min="0"
                                                   class="form-control text-end"
                                                   v-model.number="state.productPick.unitPrice">
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label">Qty</label>
                                            <div class="input-group pos-qty">
                                                <button type="button" class="btn btn-outline-secondary" v-on:click="handler.stepQty(-1)" aria-label="Decrease quantity">&minus;</button>
                                                <input type="number" step="any" min="0" class="form-control" v-model.number="state.productPick.quantity">
                                                <button type="button" class="btn btn-outline-secondary" v-on:click="handler.stepQty(1)" aria-label="Increase quantity">+</button>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label">Line Total</label>
                                            <input type="text" class="form-control text-end pos-line-total" readonly
                                                   v-bind:value="handler.formatAmount(posLineTotal)">
                                        </div>
                                    </div>
                                    <div class="small text-muted mb-3" v-if="state.productHint.name">
                                        <i class="fas fa-hashtag me-1"></i>{{ state.productHint.number || '—' }}
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-primary flex-grow-1"
                                                v-on:click="handler.addLineToCart"
                                                v-bind:disabled="state.isAddingLine">
                                            <span class="spinner-border spinner-border-sm me-2" v-if="state.isAddingLine" role="status" aria-hidden="true"></span>
                                            <i class="fas fa-cart-plus me-1" v-else></i>Add to Cart
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" v-on:click="handler.clearProductPick">Clear</button>
                                    </div>
                                </div>
                            </div>

                            <div class="card pos-card">
                                <div class="card-header">
                                    <h6><i class="fas fa-shopping-cart me-2"></i>Cart Items ({{ state.secondaryData.length }})</h6>
                                    <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none p-0"
                                            v-on:click="handler.clearCart"
                                            v-bind:disabled="!state.secondaryData.length">Clear all</button>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table pos-cart align-middle">
                                            <thead>
                                                <tr>
                                                    <th>Product</th>
                                                    <th class="text-center" style="width:132px;">Qty</th>
                                                    <th class="text-end" style="width:120px;">Unit Cost</th>
                                                    <th class="text-end" style="width:110px;">Total</th>
                                                    <th style="width:44px;"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr v-if="!state.secondaryData.length">
                                                    <td colspan="5">
                                                        <div class="pos-cart-empty">Cart is empty &mdash; search and add a product above</div>
                                                    </td>
                                                </tr>
                                                <tr v-for="line in state.secondaryData" v-bind:key="line.id">
                                                    <td>
                                                        <div class="fw-semibold">{{ line.productName }}</div>
                                                        <div class="text-muted small">{{ line.productNumber }}</div>
                                                    </td>
                                                    <td>
                                                        <div class="input-group input-group-sm pos-qty">
                                                            <button type="button" class="btn btn-outline-secondary" v-on:click="handler.stepLineQty(line, -1)" aria-label="Decrease quantity">&minus;</button>
                                                            <input type="number" step="any" min="0" class="form-control"
                                                                   v-bind:value="line.quantity"
                                                                   v-on:change="handler.commitLineQty(line, $event.target.value)">
                                                            <button type="button" class="btn btn-outline-secondary" v-on:click="handler.stepLineQty(line, 1)" aria-label="Increase quantity">+</button>
                                                        </div>
                                                    </td>
                                                    <td class="text-end">
                                                        <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end"
                                                               v-bind:value="line.unitPrice"
                                                               v-on:change="handler.commitLinePrice(line, $event.target.value)">
                                                    </td>
                                                    <td class="text-end fw-semibold">{{ handler.formatAmount((line.unitPrice || 0) * (line.quantity || 0)) }}</td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn btn-sm btn-link text-danger p-0" v-on:click="handler.removeLine(line)" title="Remove item">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT: order summary -->
                        <div class="col-lg-5">
                            <div class="card pos-card">
                                <div class="card-header">
                                    <h6><i class="fas fa-receipt me-2"></i>Order Summary</h6>
                                    <span class="badge bg-light text-dark border" v-if="state.number">{{ state.number }}</span>
                                </div>
                                <div class="card-body">
                                    <div class="pos-summary-row">
                                        <span class="text-muted">Subtotal</span>
                                        <span id="SubTotalAmount">{{ state.subTotalAmount }}</span>
                                    </div>
                                    <div class="pos-summary-row">
                                        <span class="text-muted">Tax</span>
                                        <span id="TaxAmount">{{ state.taxAmount }}</span>
                                    </div>
                                    <div class="pos-summary-row pos-summary-total">
                                        <span>Total Amount</span>
                                        <span id="TotalAmount" class="text-success">{{ state.totalAmount }}</span>
                                    </div>
                                    <div class="mt-2 pt-2 border-top" v-if="state.amountInWords">
                                        <div class="text-muted small fw-semibold">Amount in Words</div>
                                        <div id="AmountInWords" class="fst-italic text-muted small">{{ state.amountInWords }}</div>
                                    </div>
                                    <p class="text-muted small mb-0 mt-2" v-if="!state.id">
                                        Add a product to the cart to create the purchase order.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Close</button>
                    <button type="button"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                        <i v-if="!state.isSubmitting" v-bind:class="state.deleteMode ? 'fas fa-trash me-1' : 'fas fa-save me-1'"></i><span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Delete Order' : 'Save Order Details' }}</span>
                        <span v-else>{{ state.deleteMode ? 'Deleting...' : 'Saving...' }}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Vendor Group Quick Create Modal -->
    <div class="modal fade" ref="vendorGroupQuickModalRef" id="VendorGroupQuickModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="fas fa-layer-group me-2"></i>Quick Create Vendor Group</h5>
                    <button type="button" class="btn-close btn-close-white" v-on:click="handler.closeVendorGroupQuickCreate" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3"><i class="fas fa-info-circle me-1"></i>Fill in the required fields. The new group will be automatically selected after creation.</p>
                    <div class="row mb-2">
                        <div class="col-md-12">
                            <label>Name <span class="text-danger">*</span></label>
                            <input v-model="state.vendorGroupQuickName" type="text" class="form-control" placeholder="Vendor group name" />
                            <span class="text-danger small">{{ state.vendorGroupQuickErrors.name }}</span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-12">
                            <label>Description</label>
                            <textarea v-model="state.vendorGroupQuickDescription" class="form-control" rows="2" placeholder="Optional"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" v-on:click="handler.closeVendorGroupQuickCreate"><i class="fas fa-times me-1"></i>Cancel</button>
                    <button type="button" class="btn btn-success" v-on:click="handler.submitVendorGroupQuickCreate" v-bind:disabled="state.vendorGroupQuickIsSubmitting">
                        <span class="spinner-border spinner-border-sm me-1" v-if="state.vendorGroupQuickIsSubmitting"></span>
                        <i class="fas fa-layer-group me-1" v-else></i>
                        {{ state.vendorGroupQuickIsSubmitting ? 'Creating...' : 'Create & Select' }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Vendor Category Quick Create Modal -->
    <div class="modal fade" ref="vendorCategoryQuickModalRef" id="VendorCategoryQuickModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title"><i class="fas fa-tag me-2"></i>Quick Create Vendor Category</h5>
                    <button type="button" class="btn-close" v-on:click="handler.closeVendorCategoryQuickCreate" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3"><i class="fas fa-info-circle me-1"></i>Fill in the required fields. The new category will be automatically selected after creation.</p>
                    <div class="row mb-2">
                        <div class="col-md-12">
                            <label>Name <span class="text-danger">*</span></label>
                            <input v-model="state.vendorCategoryQuickName" type="text" class="form-control" placeholder="Vendor category name" />
                            <span class="text-danger small">{{ state.vendorCategoryQuickErrors.name }}</span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-12">
                            <label>Description</label>
                            <textarea v-model="state.vendorCategoryQuickDescription" class="form-control" rows="2" placeholder="Optional"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" v-on:click="handler.closeVendorCategoryQuickCreate"><i class="fas fa-times me-1"></i>Cancel</button>
                    <button type="button" class="btn btn-warning text-dark" v-on:click="handler.submitVendorCategoryQuickCreate" v-bind:disabled="state.vendorCategoryQuickIsSubmitting">
                        <span class="spinner-border spinner-border-sm me-1" v-if="state.vendorCategoryQuickIsSubmitting"></span>
                        <i class="fas fa-tag me-1" v-else></i>
                        {{ state.vendorCategoryQuickIsSubmitting ? 'Creating...' : 'Create & Select' }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Vendor Quick Create Modal -->
    <div class="modal fade" ref="vendorQuickModalRef" id="VendorQuickModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="fas fa-store me-2"></i>Quick Create Vendor</h5>
                    <button type="button" class="btn-close btn-close-white" v-on:click="handler.closeVendorQuickCreate" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3"><i class="fas fa-info-circle me-1"></i>Fill in the required fields. The new vendor will be automatically selected after creation.</p>
                    <div class="row mb-2">
                        <div class="col-md-8">
                            <label>Name <span class="text-danger">*</span></label>
                            <input v-model="state.vendorQuickName" type="text" class="form-control" placeholder="Vendor name" />
                            <span class="text-danger small">{{ state.vendorQuickErrors.name }}</span>
                        </div>
                        <div class="col-md-4">
                            <label>Country</label>
                            <input v-model="state.vendorQuickCountry" type="text" class="form-control" placeholder="Optional" />
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label>Vendor Group <span class="text-danger">*</span></label>
                            <div class="d-flex align-items-center gap-2">
                                <div ref="vendorQuickGroupIdRef" class="flex-grow-1"></div>
                                <button type="button"
                                        class="btn btn-sm btn-outline-success flex-shrink-0"
                                        v-on:click="handler.openVendorGroupQuickCreate"
                                        title="Quick-create a new vendor group">
                                    <i class="fas fa-plus me-1"></i>New
                                </button>
                            </div>
                            <span class="text-danger small">{{ state.vendorQuickErrors.vendorGroupId }}</span>
                        </div>
                        <div class="col-md-6">
                            <label>Vendor Category <span class="text-danger">*</span></label>
                            <div class="d-flex align-items-center gap-2">
                                <div ref="vendorQuickCategoryIdRef" class="flex-grow-1"></div>
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning flex-shrink-0"
                                        v-on:click="handler.openVendorCategoryQuickCreate"
                                        title="Quick-create a new vendor category">
                                    <i class="fas fa-plus me-1"></i>New
                                </button>
                            </div>
                            <span class="text-danger small">{{ state.vendorQuickErrors.vendorCategoryId }}</span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label>Street <span class="text-danger">*</span></label>
                            <input v-model="state.vendorQuickStreet" type="text" class="form-control" />
                            <span class="text-danger small">{{ state.vendorQuickErrors.street }}</span>
                        </div>
                        <div class="col-md-6">
                            <label>City <span class="text-danger">*</span></label>
                            <input v-model="state.vendorQuickCity" type="text" class="form-control" />
                            <span class="text-danger small">{{ state.vendorQuickErrors.city }}</span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-4">
                            <label>State <span class="text-danger">*</span></label>
                            <input v-model="state.vendorQuickState" type="text" class="form-control" />
                            <span class="text-danger small">{{ state.vendorQuickErrors.state }}</span>
                        </div>
                        <div class="col-md-4">
                            <label>Zip Code <span class="text-danger">*</span></label>
                            <input v-model="state.vendorQuickZipCode" type="text" class="form-control" />
                            <span class="text-danger small">{{ state.vendorQuickErrors.zipCode }}</span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label>Phone Number <span class="text-danger">*</span></label>
                            <input v-model="state.vendorQuickPhoneNumber" type="text" class="form-control" />
                            <span class="text-danger small">{{ state.vendorQuickErrors.phoneNumber }}</span>
                        </div>
                        <div class="col-md-6">
                            <label>Email Address <span class="text-danger">*</span></label>
                            <input v-model="state.vendorQuickEmailAddress" type="email" class="form-control" />
                            <span class="text-danger small">{{ state.vendorQuickErrors.emailAddress }}</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" v-on:click="handler.closeVendorQuickCreate">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>
                    <button type="button" class="btn btn-success"
                            v-on:click="handler.submitVendorQuickCreate"
                            v-bind:disabled="state.vendorQuickIsSubmitting">
                        <span class="spinner-border spinner-border-sm me-1" v-if="state.vendorQuickIsSubmitting"></span>
                        <i class="fas fa-store me-1" v-else></i>
                        {{ state.vendorQuickIsSubmitting ? 'Creating...' : 'Create & Select' }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tax Quick Create Modal -->
    <div class="modal fade" ref="taxQuickModalRef" id="TaxQuickModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="fas fa-percent me-2"></i>Quick Create Tax</h5>
                    <button type="button" class="btn-close btn-close-white" v-on:click="handler.closeTaxQuickCreate" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3"><i class="fas fa-info-circle me-1"></i>Fill in the required fields. The new tax will be automatically selected after creation.</p>
                    <div class="row mb-2">
                        <div class="col-md-8">
                            <label>Name <span class="text-danger">*</span></label>
                            <input v-model="state.taxQuickName" type="text" class="form-control" placeholder="e.g. VAT 15%" />
                            <span class="text-danger small">{{ state.taxQuickErrors.name }}</span>
                        </div>
                        <div class="col-md-4">
                            <label>Percentage <span class="text-danger">*</span></label>
                            <input v-model.number="state.taxQuickPercentage" type="number" step="0.01" min="0" max="100" class="form-control" placeholder="e.g. 15" />
                            <span class="text-danger small">{{ state.taxQuickErrors.percentage }}</span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-12">
                            <label>Description</label>
                            <textarea v-model="state.taxQuickDescription" class="form-control" rows="2" placeholder="Optional"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" v-on:click="handler.closeTaxQuickCreate">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>
                    <button type="button" class="btn btn-primary"
                            v-on:click="handler.submitTaxQuickCreate"
                            v-bind:disabled="state.taxQuickIsSubmitting">
                        <span class="spinner-border spinner-border-sm me-1" v-if="state.taxQuickIsSubmitting"></span>
                        <i class="fas fa-percent me-1" v-else></i>
                        {{ state.taxQuickIsSubmitting ? 'Creating...' : 'Create & Select' }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/PurchaseOrders/PurchaseOrderList.cshtml.js"></script>
}
