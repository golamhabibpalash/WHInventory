@page
@{
    ViewData["Title"] = "Sign In";
}

<div id="app" v-cloak>

    <div class="auth-card-mark">
        <img src="/brand-logo.png" alt="uStock" />
    </div>

    <div class="auth-form-title">
        <h2>Welcome Back! <span aria-hidden="true">&#128075;</span></h2>
        <p>Sign in to continue</p>
    </div>

    <form v-on:submit.prevent="handleSubmit" novalidate>

        <div class="auth-field">
            <div class="auth-input-group">
                <i class="fas fa-user a-icon"></i>
                <input id="Email"
                       name="Email"
                       type="email"
                       placeholder="Email address"
                       v-model="state.email"
                       v-on:input="state.errors.email = ''"
                       autocomplete="email">
            </div>
            <span v-if="state.errors.email" class="auth-field-error">{{ state.errors.email }}</span>
        </div>

        <div class="auth-field">
            <div class="auth-input-group">
                <i class="fas fa-lock a-icon"></i>
                <input id="Password"
                       name="Password"
                       v-bind:type="state.showPassword ? 'text' : 'password'"
                       placeholder="Password"
                       v-model="state.password"
                       v-on:input="state.errors.password = ''"
                       autocomplete="current-password">
                <button type="button"
                        class="auth-pw-toggle"
                        v-on:click="state.showPassword = !state.showPassword"
                        tabindex="-1"
                        aria-label="Toggle password visibility">
                    <i v-bind:class="state.showPassword ? 'fas fa-eye-slash' : 'fas fa-eye'"></i>
                </button>
            </div>
            <span v-if="state.errors.password" class="auth-field-error">{{ state.errors.password }}</span>
        </div>

        <div class="auth-options-row">
            <label class="auth-check">
                <input type="checkbox" v-model="state.rememberMe">
                <span class="auth-check-box">
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                        <polyline points="3.5,8.5 6.5,11.5 12.5,4.5"></polyline>
                    </svg>
                </span>
                <span>Remember me</span>
            </label>
            <a asp-page="/Accounts/ForgotPassword" class="auth-link">Forgot Password?</a>
        </div>

        <button type="submit" class="auth-btn" v-bind:disabled="state.isSubmitting">
            <span class="spinner-border spinner-border-sm"
                  v-if="state.isSubmitting"
                  role="status"
                  aria-hidden="true"></span>
            <span>{{ state.isSubmitting ? 'Signing in...' : 'Sign In' }}</span>
            <i class="fas fa-arrow-right auth-btn-arrow" v-if="!state.isSubmitting"></i>
        </button>

    </form>

    <p class="auth-bottom-link">
        Don't have an account? <a asp-page="/Accounts/Register">Create one</a>
        <br />
        Setting up a new organisation? <a asp-page="/Accounts/SignUp">Start here</a>
    </p>

</div>

@section scripts {
    <script type="module" src="~/FrontEnd/Pages/Accounts/Login.cshtml.js"></script>
}
