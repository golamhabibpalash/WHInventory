@page
@{
    ViewData["Title"] = "All Tickets";
}

@section styles {
    <link rel="stylesheet" href="~/css/ticket-shared.css" asp-append-version="true" />
}

<div id="app" v-cloak>
    <div class="ticket-page-header">
        <h1 class="ticket-page-title">All Tickets</h1>
        <p class="ticket-page-subtitle">Search, filter, and manage every support ticket</p>
    </div>

    <div class="ticket-filter-bar">
        <div class="row g-3 align-items-end">
            <div class="col-6 col-md-4 col-xl-2">
                <label class="ticket-filter-label">Status</label>
                <div ref="statusRef"></div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <label class="ticket-filter-label">Priority</label>
                <div ref="priorityRef"></div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <label class="ticket-filter-label">Category</label>
                <div ref="categoryRef"></div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <label class="ticket-filter-label">Assigned To</label>
                <div ref="assigneeRef"></div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <label class="ticket-filter-label">From</label>
                <div ref="fromDateRef"></div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <label class="ticket-filter-label">To</label>
                <div ref="toDateRef"></div>
            </div>
        </div>

        <div class="ticket-filter-actions">
            <div class="ticket-quick-filters">
                <button type="button" class="btn btn-sm btn-outline-secondary ticket-quick-filter" v-bind:class="{ active: state.quickFilter === 'unassigned' }" v-on:click="handler.toggleQuickFilter('unassigned')">
                    <i class="fas fa-user-slash"></i><span>Unassigned</span>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary ticket-quick-filter" v-bind:class="{ active: state.quickFilter === 'myAssigned' }" v-on:click="handler.toggleQuickFilter('myAssigned')">
                    <i class="fas fa-user"></i><span>My Assigned</span>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary ticket-quick-filter" v-bind:class="{ active: state.quickFilter === 'overdue' }" v-on:click="handler.toggleQuickFilter('overdue')">
                    <i class="fas fa-exclamation-circle"></i><span>Overdue</span>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary ticket-quick-filter" v-bind:class="{ active: state.quickFilter === 'critical' }" v-on:click="handler.toggleQuickFilter('critical')">
                    <i class="fas fa-fire"></i><span>Critical</span>
                </button>
            </div>
            <div class="ticket-filter-buttons">
                <button type="button" class="btn btn-sm btn-primary" v-on:click="handler.search"><i class="fas fa-search"></i><span>Search</span></button>
                <button type="button" class="btn btn-sm btn-outline-secondary" v-on:click="handler.clearFilters"><i class="fas fa-times"></i><span>Clear</span></button>
            </div>
        </div>
    </div>

    <div class="grid-container ticket-grid">
        <div ref="mainGridRef" id="MainGrid"></div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/TicketAgent/TicketList.cshtml.js"></script>
}
