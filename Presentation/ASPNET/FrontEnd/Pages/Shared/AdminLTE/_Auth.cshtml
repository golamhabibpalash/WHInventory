<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] — uStock</title>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,600,700&display=fallback">
    <link rel="stylesheet" href="~/adminlte/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/adminlte/css/adminlte.min.css">

    @await RenderSectionAsync("styles", required: false)

    <style>
        [v-cloak] { display: none !important; }

        *, *::before, *::after { box-sizing: border-box; }
        html, body { min-height: 100%; margin: 0; padding: 0; }
        /* body's gradient is fixed-attachment, so it only paints the viewport —
           html carries the solid colour behind anything scrolled past it. */
        html { background: #030814; }

        :root {
            --auth-bg: #030814;
            --auth-bg-2: #071026;
            --auth-panel: rgba(11, 22, 48, .55);
            --auth-border: rgba(110, 150, 255, .16);
            --auth-text: #eaf0ff;
            --auth-muted: rgba(196, 212, 255, .58);
            --auth-dim: rgba(196, 212, 255, .38);
            --auth-violet: #7c5cff;
            --auth-blue: #3b82f6;
            --auth-cyan: #38bdf8;
        }

        body.auth-body {
            font-family: 'Source Sans Pro', -apple-system, BlinkMacSystemFont, sans-serif;
            background: radial-gradient(1200px 700px at 15% 15%, #0a1730 0%, transparent 60%),
                        radial-gradient(1000px 600px at 85% 80%, #0a1b3a 0%, transparent 62%),
                        linear-gradient(160deg, var(--auth-bg) 0%, var(--auth-bg-2) 55%, var(--auth-bg) 100%);
            background-attachment: fixed;
            color: var(--auth-text);
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        /* ── 1. Background: floating particle network ─────────────── */
        .auth-particles {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }
        .auth-glow {
            position: fixed;
            border-radius: 50%;
            filter: blur(90px);
            pointer-events: none;
            z-index: 0;
        }
        .auth-glow-1 {
            width: 520px; height: 520px;
            top: -180px; left: -120px;
            background: rgba(76, 92, 255, .16);
        }
        .auth-glow-2 {
            width: 620px; height: 620px;
            bottom: -260px; right: -160px;
            background: rgba(56, 189, 248, .12);
        }

        /* ── Shell ────────────────────────────────────────────────── */
        .auth-shell {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 1.5rem;
        }
        .auth-wrapper {
            width: 100%;
            max-width: 1180px;
            display: grid;
            grid-template-columns: 1fr 460px;
            gap: 3.5rem;
            align-items: center;
        }

        /* ── Left: branding ───────────────────────────────────────── */
        .auth-left { animation: authFadeUp .7s ease both; }

        .auth-brand {
            display: flex;
            align-items: center;
            gap: .95rem;
            margin-bottom: 1.1rem;
        }
        .auth-mark {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(140deg, #7c5cff 0%, #4f46e5 100%);
            box-shadow: 0 10px 30px -8px rgba(124, 92, 255, .7);
            flex-shrink: 0;
        }
        .auth-mark svg { width: 27px; height: 27px; }
        .auth-brand-name {
            font-size: 2.5rem;
            font-weight: 700;
            letter-spacing: -.02em;
            line-height: 1;
            margin: 0;
        }

        .auth-brand-sub {
            font-size: 1.22rem;
            font-weight: 400;
            line-height: 1.45;
            color: var(--auth-muted);
            margin: 0 0 1.75rem;
        }
        .auth-rule {
            height: 1px;
            width: 100%;
            max-width: 430px;
            background: linear-gradient(90deg, rgba(120,160,255,.28), rgba(120,160,255,0));
            margin-bottom: 1.9rem;
        }

        .auth-headline {
            font-size: 1.95rem;
            font-weight: 400;
            line-height: 1.45;
            margin: 0 0 1.3rem;
            letter-spacing: -.01em;
        }
        .auth-headline strong { font-weight: 400; display: block; }
        .auth-headline .grad {
            background: linear-gradient(100deg, #8b7bff 0%, #5b8dff 55%, #38bdf8 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 600;
        }

        .auth-accent {
            display: flex;
            align-items: center;
            gap: .5rem;
            margin-bottom: 2.4rem;
        }
        .auth-accent-bar {
            width: 58px;
            height: 3px;
            border-radius: 3px;
            background: linear-gradient(90deg, #3b82f6, #7c5cff);
        }
        .auth-accent-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #60a5fa;
            box-shadow: 0 0 10px 2px rgba(96, 165, 250, .6);
        }

        /* stats */
        .auth-stats {
            display: flex;
            flex-wrap: wrap;
            gap: 2.1rem;
            margin-bottom: 2.6rem;
        }
        .auth-stat {
            display: flex;
            align-items: center;
            gap: .8rem;
        }
        .auth-stat-icon {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .95rem;
            background: var(--st-bg);
            color: var(--st-fg);
            border: 1px solid var(--st-bd);
            flex-shrink: 0;
        }
        .auth-stat-value {
            font-size: 1.32rem;
            font-weight: 700;
            line-height: 1.15;
        }
        .auth-stat-label {
            font-size: .82rem;
            color: var(--auth-dim);
        }

        /* returning-user card */
        .auth-welcome {
            display: none;
            align-items: center;
            gap: .95rem;
        }
        .auth-welcome.is-visible { display: flex; }
        .auth-avatar {
            position: relative;
            width: 52px;
            height: 52px;
            border-radius: 50%;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            font-weight: 700;
            color: #dbe6ff;
            background: linear-gradient(140deg, #24365f, #16233f);
            border: 2px solid rgba(120, 160, 255, .3);
        }
        .auth-avatar::after {
            content: '';
            position: absolute;
            right: 1px;
            bottom: 1px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #22c55e;
            border: 2px solid #071026;
        }
        .auth-welcome-hint { font-size: .82rem; color: var(--auth-dim); }
        .auth-welcome-name { font-size: 1rem; font-weight: 700; }
        .auth-welcome-last { font-size: .78rem; color: var(--auth-dim); }

        /* ── Right: glass card ────────────────────────────────────── */
        .auth-right { display: flex; justify-content: center; }
        .auth-card {
            position: relative;
            width: 100%;
            max-width: 460px;
            padding: 2.4rem 2.3rem 1.9rem;
            border-radius: 22px;
            background: var(--auth-panel);
            border: 1px solid var(--auth-border);
            box-shadow: 0 30px 70px -25px rgba(0, 0, 0, .8),
                        0 0 45px -18px rgba(90, 130, 255, .35);
            animation: authFadeUp .7s .1s ease both;
        }
        @@supports (backdrop-filter: blur(4px)) {
            .auth-card { backdrop-filter: blur(18px); }
        }
        /* hairline sheen along the top edge */
        .auth-card::before {
            content: '';
            position: absolute;
            top: -1px; left: 12%; right: 12%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(140, 180, 255, .65), transparent);
        }

        .auth-card-mark {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            margin: 0 auto 1.1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(140deg, #7c5cff 0%, #4f46e5 100%);
            box-shadow: 0 10px 28px -8px rgba(124, 92, 255, .75);
        }
        .auth-card-mark svg { width: 27px; height: 27px; }

        .auth-card-foot {
            margin-top: 1.5rem;
            text-align: center;
            font-size: .76rem;
            color: rgba(196, 212, 255, .3);
        }

        /* ── Shared form chrome ───────────────────────────────────── */
        .auth-form-title {
            text-align: center;
            margin-bottom: 1.6rem;
        }
        .auth-form-title h2 {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--auth-text);
            margin: 0 0 .3rem;
            letter-spacing: -.01em;
        }
        .auth-form-title p {
            font-size: .9rem;
            color: var(--auth-muted);
            margin: 0;
        }

        .auth-field { margin-bottom: 1rem; }
        .auth-field > label {
            display: block;
            font-size: .8rem;
            font-weight: 600;
            color: rgba(214, 226, 255, .8);
            margin-bottom: .45rem;
        }

        .auth-input-group {
            position: relative;
            display: flex;
            align-items: center;
            border-radius: 12px;
            background: rgba(8, 16, 38, .72);
            border: 1px solid rgba(110, 150, 255, .18);
            overflow: hidden;
            transition: border-color .22s ease, box-shadow .22s ease, background .22s ease;
        }
        /* 2. Input focus: glow + underline slide */
        .auth-input-group::after {
            content: '';
            position: absolute;
            left: 50%;
            right: 50%;
            bottom: 0;
            height: 2px;
            border-radius: 2px;
            background: linear-gradient(90deg, #7c5cff, #38bdf8);
            transition: left .3s ease, right .3s ease;
        }
        .auth-input-group:focus-within {
            border-color: rgba(124, 92, 255, .65);
            background: rgba(12, 22, 50, .9);
            box-shadow: 0 0 0 4px rgba(124, 92, 255, .14), 0 0 22px -6px rgba(124, 92, 255, .55);
        }
        .auth-input-group:focus-within::after { left: 0; right: 0; }
        .auth-input-group:focus-within .a-icon { color: #a78bfa; }

        .auth-input-group .a-icon {
            position: absolute;
            left: 1.05rem;
            color: rgba(160, 180, 225, .6);
            font-size: .85rem;
            pointer-events: none;
            z-index: 2;
            transition: color .22s ease;
        }
        .auth-input-group input {
            width: 100%;
            height: 52px;
            padding: 0 3rem 0 2.85rem;
            border: none;
            background: transparent;
            font-size: .95rem;
            color: var(--auth-text);
            outline: none;
            -webkit-appearance: none;
            appearance: none;
        }
        .auth-input-group input::placeholder { color: rgba(170, 188, 230, .45); }
        /* keep Chrome autofill from painting a white box over the dark field */
        .auth-input-group input:-webkit-autofill,
        .auth-input-group input:-webkit-autofill:focus {
            -webkit-text-fill-color: var(--auth-text);
            -webkit-box-shadow: 0 0 0 1000px #0b1633 inset;
            caret-color: var(--auth-text);
        }

        .auth-pw-toggle {
            position: absolute;
            right: .95rem;
            background: none;
            border: none;
            cursor: pointer;
            color: rgba(160, 180, 225, .6);
            padding: .35rem;
            font-size: .9rem;
            line-height: 1;
            z-index: 2;
            transition: color .15s;
        }
        .auth-pw-toggle:hover { color: #a78bfa; }

        .auth-field-error {
            display: block;
            font-size: .76rem;
            color: #fb7185;
            margin-top: .35rem;
            padding-left: .2rem;
        }

        .auth-options-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin: 1.15rem 0 1.4rem;
        }

        /* 4. Checkbox: smooth check animation */
        .auth-check {
            display: flex;
            align-items: center;
            gap: .55rem;
            font-size: .86rem;
            color: rgba(214, 226, 255, .82);
            cursor: pointer;
            user-select: none;
            margin: 0;
            font-weight: 400;
        }
        .auth-check input { position: absolute; opacity: 0; pointer-events: none; }
        .auth-check-box {
            width: 20px;
            height: 20px;
            border-radius: 6px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1.5px solid rgba(130, 160, 220, .45);
            background: rgba(8, 16, 38, .8);
            transition: background .25s ease, border-color .25s ease, box-shadow .25s ease, transform .2s ease;
        }
        .auth-check-box svg {
            width: 13px;
            height: 13px;
            fill: none;
            stroke: #fff;
            stroke-width: 2.4;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-dasharray: 18;
            stroke-dashoffset: 18;
            transition: stroke-dashoffset .3s ease .05s;
        }
        .auth-check input:checked + .auth-check-box {
            background: linear-gradient(135deg, #7c5cff, #4f46e5);
            border-color: transparent;
            box-shadow: 0 0 14px -2px rgba(124, 92, 255, .8);
        }
        .auth-check input:checked + .auth-check-box svg { stroke-dashoffset: 0; }
        .auth-check input:focus-visible + .auth-check-box {
            box-shadow: 0 0 0 3px rgba(124, 92, 255, .35);
        }
        .auth-check:active .auth-check-box { transform: scale(.92); }

        .auth-link {
            font-size: .86rem;
            color: rgba(214, 226, 255, .82);
            text-decoration: none;
            font-weight: 400;
            transition: color .15s;
        }
        .auth-link:hover { color: #a78bfa; text-decoration: none; }

        /* 3. Button hover: gradient shift + glow */
        .auth-btn {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .6rem;
            width: 100%;
            height: 54px;
            border: none;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 600;
            color: #fff;
            cursor: pointer;
            background: linear-gradient(100deg, #6d4aff 0%, #4361ee 35%, #7c5cff 70%, #4f46e5 100%);
            background-size: 240% 100%;
            background-position: 0% 50%;
            box-shadow: 0 12px 30px -12px rgba(109, 74, 255, .85);
            transition: background-position .55s ease, box-shadow .3s ease, transform .18s ease;
        }
        .auth-btn:hover:not(:disabled) {
            background-position: 100% 50%;
            box-shadow: 0 16px 38px -12px rgba(124, 92, 255, 1);
            transform: translateY(-1px);
        }
        .auth-btn:active:not(:disabled) { transform: translateY(0); }
        .auth-btn:disabled { opacity: .65; cursor: not-allowed; transform: none; }
        .auth-btn-arrow {
            position: absolute;
            right: 1.4rem;
            font-size: .9rem;
            transition: transform .25s ease;
        }
        .auth-btn:hover:not(:disabled) .auth-btn-arrow { transform: translateX(4px); }

        .auth-bottom-link {
            text-align: center;
            font-size: .86rem;
            color: var(--auth-muted);
            margin: 1.2rem 0 0;
        }
        .auth-bottom-link a {
            color: #a78bfa;
            font-weight: 600;
            text-decoration: none;
        }
        .auth-bottom-link a:hover { text-decoration: underline; }

        /* ── Dark treatment for the Bootstrap/AdminLTE markup that
              Register, Forgot Password, Email Confirm and Logout use ── */
        /* AdminLTE paints these white; strip the chrome so the glass card shows through. */
        .auth-card .card,
        .auth-card .card-body,
        .auth-card .login-card-body,
        .auth-card .register-card-body,
        .auth-card .container-fluid {
            background: transparent;
            border: none;
            box-shadow: none;
            padding: 0;
            color: var(--auth-text);
        }
        .auth-card .login-box-msg,
        .auth-card .register-card-body > p:first-child {
            color: var(--auth-text);
            font-size: 1.35rem;
            font-weight: 700;
            text-align: center;
            padding: 0;
            margin-bottom: 1.5rem;
        }
        .auth-card .form-control {
            height: 50px;
            background: rgba(8, 16, 38, .72);
            border: 1px solid rgba(110, 150, 255, .18);
            border-radius: 12px;
            color: var(--auth-text);
            font-size: .95rem;
            box-shadow: none;
            transition: border-color .22s ease, box-shadow .22s ease, background .22s ease;
        }
        .auth-card .form-control::placeholder { color: rgba(170, 188, 230, .45); }
        .auth-card .form-control:focus {
            background: rgba(12, 22, 50, .9);
            border-color: rgba(124, 92, 255, .65);
            color: var(--auth-text);
            box-shadow: 0 0 0 4px rgba(124, 92, 255, .14), 0 0 22px -6px rgba(124, 92, 255, .55);
        }
        .auth-card .input-group { gap: .5rem; }
        .auth-card .input-group-text {
            height: 50px;
            background: rgba(8, 16, 38, .72);
            border: 1px solid rgba(110, 150, 255, .18);
            border-radius: 12px;
            color: rgba(160, 180, 225, .7);
        }
        .auth-card .btn-primary {
            height: 48px;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            background: linear-gradient(100deg, #6d4aff 0%, #4361ee 35%, #7c5cff 70%, #4f46e5 100%);
            background-size: 240% 100%;
            background-position: 0% 50%;
            box-shadow: 0 12px 30px -14px rgba(109, 74, 255, .85);
            transition: background-position .55s ease, box-shadow .3s ease, transform .18s ease;
        }
        .auth-card .btn-primary:hover:not(:disabled),
        .auth-card .btn-primary:focus:not(:disabled) {
            background-position: 100% 50%;
            box-shadow: 0 16px 38px -14px rgba(124, 92, 255, 1);
            transform: translateY(-1px);
        }
        .auth-card a { color: #a78bfa; }
        .auth-card a:hover { color: #c4b5fd; }
        .auth-card .text-dark { color: var(--auth-text) !important; }
        .auth-card .text-danger { color: #fb7185 !important; }
        .auth-card label,
        .auth-card .icheck-primary label { color: rgba(214, 226, 255, .8); }
        /* AdminLTE's icheck draws its box on label::before — recolour it for the dark card. */
        .auth-card .icheck-primary > input:first-child + label::before {
            background: rgba(8, 16, 38, .8);
            border: 1.5px solid rgba(130, 160, 220, .45);
            border-radius: 5px;
            transition: background .25s ease, border-color .25s ease;
        }
        .auth-card .icheck-primary > input:first-child:checked + label::before {
            background: linear-gradient(135deg, #7c5cff, #4f46e5);
            border-color: transparent;
        }
        .auth-card .mb-1 a,
        .auth-card p { color: rgba(214, 226, 255, .8); }
        .auth-card hr { border-color: rgba(110, 150, 255, .18); }

        /* ── 5. Success message: slide in from right, then fade out ── */
        .auth-toast {
            position: fixed;
            top: 1.75rem;
            right: 1.75rem;
            z-index: 60;
            display: flex;
            align-items: flex-start;
            gap: .8rem;
            min-width: 300px;
            max-width: min(370px, calc(100vw - 2.5rem));
            padding: 1rem 1.1rem;
            border-radius: 14px;
            background: rgba(9, 32, 26, .96);
            border: 1px solid rgba(34, 197, 94, .35);
            box-shadow: 0 24px 50px -18px rgba(0, 0, 0, .85);
            color: #eafff4;
            opacity: 0;
            transform: translateX(120%);
            pointer-events: none;
            transition: transform .45s cubic-bezier(.22, 1, .36, 1), opacity .45s ease;
        }
        .auth-toast.is-visible {
            opacity: 1;
            transform: translateX(0);
            pointer-events: auto;
        }
        .auth-toast.is-error {
            background: rgba(42, 12, 20, .96);
            border-color: rgba(244, 63, 94, .38);
            color: #ffe9ee;
        }
        .auth-toast-icon {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .8rem;
            background: #22c55e;
            color: #05210f;
        }
        .auth-toast.is-error .auth-toast-icon { background: #f43f5e; color: #2a0c14; }
        .auth-toast-body { flex: 1; min-width: 0; }
        .auth-toast-title { font-size: .92rem; font-weight: 700; }
        .auth-toast-text { font-size: .82rem; opacity: .82; margin-top: .1rem; }
        .auth-toast-close {
            background: none;
            border: none;
            color: inherit;
            opacity: .5;
            cursor: pointer;
            padding: .1rem .2rem;
            font-size: .82rem;
            line-height: 1;
        }
        .auth-toast-close:hover { opacity: 1; }

        @@keyframes authFadeUp {
            from { opacity: 0; transform: translateY(18px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ── Responsive ───────────────────────────────────────────── */
        @@media (max-width: 1080px) {
            .auth-wrapper { grid-template-columns: 1fr; gap: 2.5rem; max-width: 560px; }
            .auth-left { text-align: center; }
            .auth-brand, .auth-stats, .auth-accent, .auth-welcome.is-visible { justify-content: center; }
            .auth-rule { margin-left: auto; margin-right: auto; }
            .auth-right { justify-content: center; }
        }
        @@media (max-width: 640px) {
            .auth-shell { padding: 1.5rem 1rem; }
            .auth-card { padding: 1.9rem 1.4rem 1.5rem; }
            .auth-brand-name { font-size: 2rem; }
            .auth-brand-sub { font-size: 1.05rem; }
            .auth-headline { font-size: 1.55rem; }
            .auth-stats { gap: 1.25rem; }
            .auth-toast { top: 1rem; right: 1rem; left: 1rem; min-width: 0; }
        }

        @@media (prefers-reduced-motion: reduce) {
            .auth-left, .auth-card { animation: none; }
            .auth-toast { transition: opacity .2s ease; transform: none; }
            .auth-particles { display: none; }
        }
    </style>

    @* vue *@
    <script src="~/lib/vue/vue.global.prod.js"></script>

    <script src="~/lib/axios/axios.min.js" defer></script>
    <script src="~/lib/sweetalert/sweetalert2v11.js" defer></script>
    <script src="~/lib/indotalent/storage-manager.js" defer></script>
    <script src="~/lib/indotalent/security-manager.js" defer></script>
    <script src="~/lib/indotalent/axios-manager.js" defer></script>
</head>

<body class="auth-body">

    <canvas id="authParticles" class="auth-particles" aria-hidden="true"></canvas>
    <div class="auth-glow auth-glow-1" aria-hidden="true"></div>
    <div class="auth-glow auth-glow-2" aria-hidden="true"></div>

    <div class="auth-shell">
        <div class="auth-wrapper">

            <!-- Left: branding -->
            <aside class="auth-left">
                <div class="auth-brand">
                    <span class="auth-mark">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 2 3 6.5 12 11l9-4.5L12 2Z" fill="#fff" opacity=".95"/>
                            <path d="M3 12 12 16.5 21 12" fill="none" stroke="#fff" stroke-width="1.9"
                                  stroke-linecap="round" stroke-linejoin="round" opacity=".8"/>
                            <path d="M3 17.5 12 22l9-4.5" fill="none" stroke="#fff" stroke-width="1.9"
                                  stroke-linecap="round" stroke-linejoin="round" opacity=".55"/>
                        </svg>
                    </span>
                    <h1 class="auth-brand-name">uStock</h1>
                </div>

                <p class="auth-brand-sub">Warehouse &amp; Inventory<br>Management System</p>

                <div class="auth-rule"></div>

                <p class="auth-headline">
                    <strong>One System.</strong>
                    <strong>Complete <span class="grad">Inventory Control.</span></strong>
                </p>

                <div class="auth-accent">
                    <span class="auth-accent-bar"></span>
                    <span class="auth-accent-dot"></span>
                </div>

                <div class="auth-stats">
                    <div class="auth-stat">
                        <span class="auth-stat-icon"
                              style="--st-bg:rgba(59,130,246,.16); --st-fg:#60a5fa; --st-bd:rgba(59,130,246,.28);">
                            <i class="fas fa-smile"></i>
                        </span>
                        <span>
                            <span class="auth-stat-value">120+</span>
                            <span class="auth-stat-label d-block">Happy Clients</span>
                        </span>
                    </div>
                    <div class="auth-stat">
                        <span class="auth-stat-icon"
                              style="--st-bg:rgba(124,92,255,.16); --st-fg:#a78bfa; --st-bd:rgba(124,92,255,.28);">
                            <i class="fas fa-chart-line"></i>
                        </span>
                        <span>
                            <span class="auth-stat-value">98.8%</span>
                            <span class="auth-stat-label d-block">System Uptime</span>
                        </span>
                    </div>
                    <div class="auth-stat">
                        <span class="auth-stat-icon"
                              style="--st-bg:rgba(56,189,248,.16); --st-fg:#38bdf8; --st-bd:rgba(56,189,248,.28);">
                            <i class="fas fa-headset"></i>
                        </span>
                        <span>
                            <span class="auth-stat-value">24/7</span>
                            <span class="auth-stat-label d-block">Support</span>
                        </span>
                    </div>
                </div>

                <!-- Shown only when a remembered user exists on this device -->
                <div class="auth-welcome" id="authWelcome">
                    <span class="auth-avatar" id="authWelcomeInitials"></span>
                    <span>
                        <span class="auth-welcome-hint d-block">Welcome back,</span>
                        <span class="auth-welcome-name d-block" id="authWelcomeName"></span>
                        <span class="auth-welcome-last d-block" id="authWelcomeLast"></span>
                    </span>
                </div>
            </aside>

            <!-- Right: form card -->
            <main class="auth-right">
                <div class="auth-card">
                    @RenderBody()
                    <div class="auth-card-foot">
                        &copy; @DateTime.Now.Year uStock. All rights reserved.
                    </div>
                </div>
            </main>

        </div>
    </div>

    <div class="auth-toast" id="authToast" role="status" aria-live="polite">
        <span class="auth-toast-icon"><i class="fas fa-check" id="authToastIcon"></i></span>
        <span class="auth-toast-body">
            <span class="auth-toast-title d-block" id="authToastTitle"></span>
            <span class="auth-toast-text d-block" id="authToastText"></span>
        </span>
        <button type="button" class="auth-toast-close" id="authToastClose" aria-label="Dismiss">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <script src="~/adminlte/plugins/jquery/jquery.min.js"></script>
    <script src="~/adminlte/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/adminlte/js/adminlte.min.js"></script>

    <script>
        // ── 1. Floating particle network ────────────────────────────
        (function () {
            var canvas = document.getElementById('authParticles');
            if (!canvas || !canvas.getContext) return;
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            var ctx = canvas.getContext('2d');
            var particles = [];
            var width = 0, height = 0, ratio = window.devicePixelRatio || 1;
            var LINK_DISTANCE = 140;

            function resize() {
                width = canvas.clientWidth;
                height = canvas.clientHeight;
                canvas.width = width * ratio;
                canvas.height = height * ratio;
                ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

                // Scale the swarm to the viewport, but keep the line maths cheap.
                var target = Math.min(90, Math.max(30, Math.round((width * height) / 22000)));
                particles = [];
                for (var i = 0; i < target; i++) {
                    particles.push({
                        x: Math.random() * width,
                        y: Math.random() * height,
                        vx: (Math.random() - 0.5) * 0.28,
                        vy: (Math.random() - 0.5) * 0.28,
                        r: Math.random() * 1.6 + 0.7
                    });
                }
            }

            function step() {
                ctx.clearRect(0, 0, width, height);

                for (var i = 0; i < particles.length; i++) {
                    var p = particles[i];
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0 || p.x > width) p.vx *= -1;
                    if (p.y < 0 || p.y > height) p.vy *= -1;

                    for (var j = i + 1; j < particles.length; j++) {
                        var q = particles[j];
                        var dx = p.x - q.x;
                        var dy = p.y - q.y;
                        var dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < LINK_DISTANCE) {
                            ctx.strokeStyle = 'rgba(96, 150, 255, ' + (0.16 * (1 - dist / LINK_DISTANCE)) + ')';
                            ctx.lineWidth = 1;
                            ctx.beginPath();
                            ctx.moveTo(p.x, p.y);
                            ctx.lineTo(q.x, q.y);
                            ctx.stroke();
                        }
                    }

                    ctx.fillStyle = 'rgba(125, 180, 255, .75)';
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fill();
                }

                requestAnimationFrame(step);
            }

            window.addEventListener('resize', resize);
            resize();
            requestAnimationFrame(step);
        })();

        // ── 5. Toast: slide in from the right, then fade out ────────
        (function () {
            var toast = document.getElementById('authToast');
            var titleEl = document.getElementById('authToastTitle');
            var textEl = document.getElementById('authToastText');
            var iconEl = document.getElementById('authToastIcon');
            var closeEl = document.getElementById('authToastClose');
            var timer = null;

            function hide() {
                if (!toast) return;
                toast.classList.remove('is-visible');
            }

            if (closeEl) closeEl.addEventListener('click', hide);

            window.showAuthToast = function (options) {
                if (!toast) return;
                var opts = options || {};
                var isError = opts.variant === 'error';

                titleEl.textContent = opts.title || (isError ? 'Something went wrong' : 'Success');
                textEl.textContent = opts.text || '';
                textEl.style.display = opts.text ? '' : 'none';
                iconEl.className = isError ? 'fas fa-exclamation' : 'fas fa-check';
                toast.classList.toggle('is-error', isError);
                toast.classList.add('is-visible');

                window.clearTimeout(timer);
                timer = window.setTimeout(hide, opts.duration || 3000);
            };

            window.hideAuthToast = hide;
        })();

        // ── Returning-user card on the branding panel ───────────────
        (function () {
            var card = document.getElementById('authWelcome');
            if (!card) return;

            var email = '';
            try {
                email = window.localStorage.getItem('rememberedEmail') || '';
            } catch (e) {
                return;
            }
            if (!email) return;

            var local = email.split('@@')[0].replace(/[._-]+/g, ' ').trim();
            var name = local.replace(/\b\w/g, function (c) { return c.toUpperCase(); }) || email;
            var initials = name.split(/\s+/).slice(0, 2).map(function (w) { return w.charAt(0); }).join('');

            document.getElementById('authWelcomeName').textContent = name;
            document.getElementById('authWelcomeInitials').textContent = initials.toUpperCase();

            var lastEl = document.getElementById('authWelcomeLast');
            var stamp = '';
            try {
                stamp = window.localStorage.getItem('lastLoginAt') || '';
            } catch (e) { /* ignore */ }

            if (stamp) {
                var when = new Date(stamp);
                if (!isNaN(when.getTime())) {
                    var time = when.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
                    var isToday = when.toDateString() === new Date().toDateString();
                    var day = isToday ? 'Today' : when.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
                    lastEl.textContent = 'Last login: ' + day + ', ' + time;
                }
            } else {
                lastEl.style.display = 'none';
            }

            card.classList.add('is-visible');
        })();
    </script>

    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
