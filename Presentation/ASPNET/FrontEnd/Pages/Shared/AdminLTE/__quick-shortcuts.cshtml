@*
    Quick-access shortcut dock: a fixed vertical rail on the right edge, vertically centered.
    Icon-only at rest; hovering (or focusing, for keyboard users) reveals the full name. The set
    of shortcuts is admin-configurable from Settings > Quick Shortcuts (QuickShortcutController /
    FrontEnd/Pages/QuickShortcuts/QuickShortcutList.cshtml) rather than hardcoded here, so this
    partial only renders a container and fetches+builds the actual items in script. Each target
    page still runs its own SecurityManager.authorizePage check on navigation, so a shortcut
    pointed at a page the viewer can't open simply redirects them there rather than being a
    security gap — this dock is a convenience list, not an access-control surface.
*@
<div class="quick-shortcuts" id="QuickShortcuts" aria-label="Quick access shortcuts"></div>

<script>
    document.addEventListener('DOMContentLoaded', async function () {
        try {
            const dock = document.getElementById('QuickShortcuts');
            if (!dock) return;

            const response = await AxiosManager.get('/QuickShortcut/GetQuickShortcutList', {});
            const shortcuts = response?.data?.content?.data ?? [];

            if (!shortcuts.length) {
                dock.remove();
                return;
            }

            const firstSegment = (window.location.pathname.split('/')[1] || '').toLowerCase();

            shortcuts.forEach(function (shortcut) {
                if (!shortcut.url || !shortcut.name) return;

                const item = document.createElement('a');
                item.className = 'quick-shortcut-item';
                item.href = shortcut.url;

                const targetSegment = (shortcut.url.split('/')[1] || '').toLowerCase();
                if (targetSegment && targetSegment === firstSegment) {
                    item.classList.add('quick-shortcut-active');
                }

                const icon = document.createElement('span');
                icon.className = 'quick-shortcut-icon';
                const iconTag = document.createElement('i');
                iconTag.className = shortcut.icon || 'fas fa-link';
                icon.appendChild(iconTag);

                const label = document.createElement('span');
                label.className = 'quick-shortcut-label';
                label.textContent = shortcut.name;

                item.appendChild(icon);
                item.appendChild(label);
                dock.appendChild(item);
            });
        } catch (error) {
            console.error('Error loading quick shortcuts:', error);
        }
    });
</script>
