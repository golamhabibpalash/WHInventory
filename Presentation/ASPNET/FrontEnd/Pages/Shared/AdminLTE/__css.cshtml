    /* Draggable modals (modal-drag-manager.js): header is the drag handle for every modal. */
    .modal-header-draggable {
        cursor: move;
        touch-action: none;
    }

    .modal-header-draggable.modal-header-dragging {
        cursor: grabbing;
        user-select: none;
    }

    /* Inline role-access checkbox toggle (UserList Change Roles modal) */
    .role-access-toggle {
        width: 1.15em;
        height: 1.15em;
        cursor: pointer;
        accent-color: var(--primary);
    }

    /* Quick-access shortcut dock (__quick-shortcuts.cshtml): fixed vertical rail, right-middle
       of the viewport. Icon-only "chip" at rest, outlined in the theme primary; hover/focus
       animates it into a solid theme-color fill and slides the full name out — a max-width
       transition rather than a Bootstrap tooltip, since a tooltip this close to the screen edge
       tends to get clipped or auto-flip awkwardly.

       align-items: flex-end is load-bearing, not decorative: the default (stretch) makes every
       sibling chip match the *container's* cross-size, so widening one chip on hover silently
       widened all four at once. flex-end lets each chip size to its own content and stay pinned
       to the shared right edge, so only the hovered chip itself ever animates. */
    .quick-shortcuts {
        position: fixed;
        top: 50%;
        right: 0;
        transform: translateY(-50%);
        z-index: 1030;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: .6rem;
    }

    .quick-shortcut-item {
        display: flex;
        align-items: center;
        height: 46px;
        max-width: 46px;
        background: #fff;
        color: var(--primary);
        border: 1px solid #dee2e6;
        border-right: 0;
        border-radius: .5rem 0 0 .5rem;
        box-shadow: 0 4px 14px -4px rgba(15, 23, 42, .18);
        overflow: hidden;
        text-decoration: none;
        white-space: nowrap;
        opacity: 0;
        transform: translateX(18px);
        animation: quickShortcutIn .45s cubic-bezier(.16, 1, .3, 1) forwards;
        transition: max-width .35s cubic-bezier(.4, 0, .2, 1),
                    background-color .25s ease,
                    border-color .25s ease,
                    color .25s ease,
                    box-shadow .3s ease;
    }

    .quick-shortcut-item:nth-child(1) { animation-delay: .05s; }
    .quick-shortcut-item:nth-child(2) { animation-delay: .12s; }
    .quick-shortcut-item:nth-child(3) { animation-delay: .19s; }
    .quick-shortcut-item:nth-child(4) { animation-delay: .26s; }

    @@keyframes quickShortcutIn {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .quick-shortcut-item:hover, .quick-shortcut-item:focus {
        max-width: 210px;
        background: var(--primary);
        color: #fff;
        border-color: var(--primary);
        box-shadow: 0 10px 26px -6px rgba(27, 132, 255, .5);
        text-decoration: none;
    }

    /* The item matching the module the user is currently on: a resting tinted accent, not a
       full fill, so the solid theme-color fill still reads as a hover-only reaction. */
    .quick-shortcut-item.quick-shortcut-active {
        background: #f0f7ff;
        border-color: var(--primary);
        color: var(--primary);
    }

    .quick-shortcut-item.quick-shortcut-active:hover,
    .quick-shortcut-item.quick-shortcut-active:focus {
        background: var(--primary);
        color: #fff;
    }

    .quick-shortcut-icon {
        flex: 0 0 44px;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        transition: transform .25s ease;
    }

    .quick-shortcut-item:hover .quick-shortcut-icon,
    .quick-shortcut-item:focus .quick-shortcut-icon {
        transform: scale(1.1);
    }

    .quick-shortcut-label {
        font-size: .8125rem;
        font-weight: 600;
        padding-right: 1rem;
        opacity: 0;
        transition: opacity .2s ease;
    }

    .quick-shortcut-item:hover .quick-shortcut-label,
    .quick-shortcut-item:focus .quick-shortcut-label {
        opacity: 1;
        transition: opacity .25s ease .1s;
    }

    @@media (max-width: 576px) {
        .quick-shortcuts {
            display: none;
        }
    }

    /* Remove up/down spinner arrows from number inputs */
    input[type=number]::-webkit-outer-spin-button,
    input[type=number]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    input[type=number] {
