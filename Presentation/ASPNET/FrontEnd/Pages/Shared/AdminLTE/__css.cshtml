<style>
    #navbarnav {
        width: 100%;
        height: auto;
        overflow-y: visible;
    }

    /* Fixed sidebar: always visible, never scrolls with page body */
    .main-sidebar {
        position: fixed !important;
        top: 0;
        left: 0;
        height: 100vh;
        overflow: hidden;
        z-index: 1038;
    }

    /* Sidebar inner content scrolls independently when taller than viewport */
    .main-sidebar .sidebar {
        height: calc(100vh - 57px);
        overflow-y: auto;
        overflow-x: hidden;
    }

    a {
