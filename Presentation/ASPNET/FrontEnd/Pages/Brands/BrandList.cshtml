@page
@{
    ViewData["Title"] = "Brand List";
}

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef" id="MainGrid"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" v-model="state.id" id="Id" name="Id" />
                    <form id="MainForm">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5><i class="fas fa-info-circle me-2 text-primary"></i>Main Info</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="Name">Name</label>
                                                <input ref="nameRef" v-model="state.name">
                                                <label class="text-danger">{{ state.errors.name }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="Number">Code</label>
                                                <input ref="numberRef" v-model="state.number" readonly>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-12">
                                                <label for="Description">Description</label>
                                                <textarea v-model="state.description" id="Description" name="Description" class="form-control" rows="3"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Close</button>
                    <button type="button"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                        <i v-if="!state.isSubmitting" v-bind:class="state.deleteMode ? 'fas fa-trash me-1' : 'fas fa-save me-1'"></i><span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Delete' : 'Save' }}</span>
                        <span v-else>{{ state.deleteMode ? 'Deleting...' : 'Saving...' }}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bulk Upload Modal -->
    <div class="modal fade" ref="bulkUploadModalRef" id="BulkUploadModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="fas fa-file-upload me-2"></i>Bulk Brand Upload</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="fas fa-download me-2"></i>
                        <a href="/api/Brand/DownloadImportTemplate" class="alert-link">Download the Excel template</a>
                        and fill in your brand data. The first row must contain the column headers.
                    </div>
                    <div class="table-responsive small mb-3">
                        <table class="table table-bordered table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>Column</th>
                                    <th>Required</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>Name</td><td><span class="badge bg-danger">Yes</span></td><td>Brand name, must not already exist</td></tr>
                                <tr><td>Description</td><td><span class="badge bg-secondary">No</span></td><td>Brand description</td></tr>
                                <tr><td>Status</td><td><span class="badge bg-secondary">No</span></td><td>Active or Inactive (defaults to Active)</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p class="text-muted small">The brand code is generated automatically, so the template has no column for it.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select Excel File (.xlsx)</label>
                        <input ref="bulkFileInputRef" type="file" class="form-control" accept=".xlsx" v-on:change="handler.onBulkFileSelected" />
                    </div>
                    <div v-if="state.bulkUploadResult" class="mt-3">
                        <div class="alert" v-bind:class="state.bulkUploadResult.failureCount > 0 ? 'alert-warning' : 'alert-success'">
                            <strong>Upload Complete:</strong>
                            {{ state.bulkUploadResult.successCount }} of {{ state.bulkUploadResult.totalRows }} brands created successfully.
                            <span v-if="state.bulkUploadResult.failureCount > 0">
                                {{ state.bulkUploadResult.failureCount }} row(s) failed.
                            </span>
                        </div>
                        <div v-if="state.bulkUploadResult.errors && state.bulkUploadResult.errors.length > 0" class="mt-2">
                            <h6 class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>Error Details</h6>
                            <div class="table-responsive" style="max-height:250px; overflow-y:auto;">
                                <table class="table table-sm table-bordered">
                                    <thead class="table-danger">
                                        <tr>
                                            <th>Row</th>
                                            <th>Name</th>
                                            <th>Error</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr v-for="err in state.bulkUploadResult.errors" :key="err.rowNumber">
                                            <td>{{ err.rowNumber }}</td>
                                            <td>{{ err.name }}</td>
                                            <td class="text-danger">{{ err.message }}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Close</button>
                    <button type="button" class="btn btn-primary"
                            v-on:click="handler.submitBulkUpload"
                            v-bind:disabled="state.bulkUploadSubmitting || !state.bulkUploadFile">
                        <span class="spinner-border spinner-border-sm me-1" v-if="state.bulkUploadSubmitting"></span>
                        <i class="fas fa-upload me-1" v-else></i>
                        {{ state.bulkUploadSubmitting ? 'Uploading...' : 'Upload & Create' }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Brands/BrandList.cshtml.js"></script>
}
