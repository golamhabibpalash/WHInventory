@page
@{
    ViewData["Title"] = "Default Dashboard";
}

@section styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div id="app" v-cloak>
<div class="form-card" id="formcard">
<div class="container-fluid py-4 px-4">
<div class="db-wrap">

    <!-- ── Page header ──────────────────────────────────────── -->
    <div class="db-header">
        <div>
            <h1 class="db-header-title">Dashboard Overview</h1>
            <p class="db-header-sub">Real-time summary of your warehouse &amp; inventory operations</p>
        </div>
        <div class="db-header-meta">
            <div class="db-chip db-chip--brand" v-if="state.companyName">
                <i class="fas fa-building"></i>
                <span>{{ state.companyName }}</span>
            </div>

            <label class="db-chip db-chip--select">
                <i class="fas fa-warehouse"></i>
                <span class="sr-only">Warehouse</span>
                <select v-model="state.selectedWarehouseId"
                        v-on:change="methods.changeWarehouse"
                        v-bind:disabled="state.isReloading">
                    <option value="">All Warehouses</option>
                    <option v-for="warehouse in state.warehouses"
                            v-bind:key="warehouse.id"
                            v-bind:value="warehouse.id">{{ warehouse.name }}</option>
                </select>
            </label>

            <div class="db-chip">
                <i class="fas fa-calendar-alt"></i>
                <span>{{ state.todayLabel }}</span>
            </div>
        </div>
    </div>

    <div class="db-alert" v-if="state.loadError">
        <i class="fas fa-exclamation-circle"></i>
        <span>{{ state.loadError }}</span>
    </div>

    <!-- ── Order documents ──────────────────────────────────── -->
    <div class="row g-3">
        <div class="col-sm-6 col-xl-3">
            <a href="/SalesOrders/SalesOrderList" class="gtile-link">
                <div class="gtile" style="--g1:#a855f7; --g2:#7c6ef5;">
                    <div class="gtile-top">
                        <div>
                            <div class="gtile-label">Sales</div>
                            <div class="gtile-value"><span ref="cardSalesQtyRef">&mdash;</span></div>
                        </div>
                        <div class="gtile-icon"><i class="fas fa-chart-line"></i></div>
                    </div>
                    <div class="gtile-desc">total sales orders</div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a href="/SalesReturns/SalesReturnList" class="gtile-link">
                <div class="gtile" style="--g1:#fbbf24; --g2:#f97316;">
                    <div class="gtile-top">
                        <div>
                            <div class="gtile-label">Sales Return</div>
                            <div class="gtile-value"><span ref="cardSalesReturnQtyRef">&mdash;</span></div>
                        </div>
                        <div class="gtile-icon"><i class="fas fa-undo-alt"></i></div>
                    </div>
                    <div class="gtile-desc">total return orders</div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a href="/PurchaseOrders/PurchaseOrderList" class="gtile-link">
                <div class="gtile" style="--g1:#22c55e; --g2:#10b981;">
                    <div class="gtile-top">
                        <div>
                            <div class="gtile-label">Purchase</div>
                            <div class="gtile-value"><span ref="cardPurchaseQtyRef">&mdash;</span></div>
                        </div>
                        <div class="gtile-icon"><i class="fas fa-shopping-cart"></i></div>
                    </div>
                    <div class="gtile-desc">total purchase orders</div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a href="/PurchaseReturns/PurchaseReturnList" class="gtile-link">
                <div class="gtile" style="--g1:#8b5cf6; --g2:#a78bfa;">
                    <div class="gtile-top">
                        <div>
                            <div class="gtile-label">Purchase Return</div>
                            <div class="gtile-value"><span ref="cardPurchaseReturnQtyRef">&mdash;</span></div>
                        </div>
                        <div class="gtile-icon"><i class="fas fa-undo"></i></div>
                    </div>
                    <div class="gtile-desc">total return orders</div>
                </div>
            </a>
        </div>
    </div>

    <!-- ── Warehouse movements ──────────────────────────────── -->
    <div class="row g-3">
        <div class="col-sm-6 col-xl-3">
            <a href="/DeliveryOrders/DeliveryOrderList" class="gtile-link">
                <div class="gtile" style="--g1:#2563eb; --g2:#3b82f6;">
                    <div class="gtile-top">
                        <div>
                            <div class="gtile-label">Delivery Order</div>
                            <div class="gtile-value"><span ref="cardDeliveryOrderQtyRef">&mdash;</span></div>
                        </div>
                        <div class="gtile-icon"><i class="fas fa-truck"></i></div>
                    </div>
                    <div class="gtile-desc">deliveries dispatched</div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a href="/GoodsReceives/GoodsReceiveList" class="gtile-link">
                <div class="gtile" style="--g1:#0ea5e9; --g2:#38bdf8;">
                    <div class="gtile-top">
                        <div>
                            <div class="gtile-label">Goods Receive</div>
                            <div class="gtile-value"><span ref="cardGoodsReceiveQtyRef">&mdash;</span></div>
                        </div>
                        <div class="gtile-icon"><i class="fas fa-boxes"></i></div>
                    </div>
                    <div class="gtile-desc">receipts processed</div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a href="/TransferOuts/TransferOutList" class="gtile-link">
                <div class="gtile" style="--g1:#ef4444; --g2:#f87171;">
                    <div class="gtile-top">
                        <div>
                            <div class="gtile-label">Transfer Out</div>
                            <div class="gtile-value"><span ref="cardTransferOutQtyRef">&mdash;</span></div>
                        </div>
                        <div class="gtile-icon"><i class="fas fa-sign-out-alt"></i></div>
                    </div>
                    <div class="gtile-desc">outbound transfers</div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a href="/TransferIns/TransferInList" class="gtile-link">
                <div class="gtile" style="--g1:#14b8a6; --g2:#34d399;">
                    <div class="gtile-top">
                        <div>
                            <div class="gtile-label">Transfer In</div>
                            <div class="gtile-value"><span ref="cardTransferInQtyRef">&mdash;</span></div>
                        </div>
                        <div class="gtile-icon"><i class="fas fa-sign-in-alt"></i></div>
                    </div>
                    <div class="gtile-desc">inbound transfers</div>
                </div>
            </a>
        </div>
    </div>

    <!-- ── KPI tiles ────────────────────────────────────────── -->
    <div class="row g-3">
        <div class="col-sm-6 col-xl-3">
            <a v-bind:href="methods.stockReportUrl()" class="kpi-tile-link" title="View the stock report">
                <div class="kpi-tile">
                    <div class="kpi-tile-icon" style="--kt-bg:rgba(99,102,241,.12); --kt-fg:#6366f1;">
                        <i class="fas fa-warehouse"></i>
                    </div>
                    <div>
                        <div class="kpi-tile-label">Total Inventory</div>
                        <div class="kpi-tile-value">
                            {{ methods.formatQty(state.kpi.totalInventory) }}
                            <i class="fas fa-chevron-right kpi-tile-cta"></i>
                        </div>
                        <div class="kpi-tile-foot">
                            <span v-bind:class="['kpi-delta', methods.deltaClass(state.kpi.totalInventoryDeltaPct)]">
                                <i v-bind:class="methods.deltaIcon(state.kpi.totalInventoryDeltaPct)"></i>
                                {{ methods.formatDelta(state.kpi.totalInventoryDeltaPct) }}
                            </span>
                            <span>vs last month</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a v-bind:href="methods.inboundReportUrl()" class="kpi-tile-link" title="View today's inbound transactions">
                <div class="kpi-tile">
                    <div class="kpi-tile-icon" style="--kt-bg:rgba(16,185,129,.12); --kt-fg:#10b981;">
                        <i class="fas fa-arrow-down"></i>
                    </div>
                    <div>
                        <div class="kpi-tile-label">Inbound Today</div>
                        <div class="kpi-tile-value">
                            {{ methods.formatQty(state.kpi.inboundToday) }}
                            <i class="fas fa-chevron-right kpi-tile-cta"></i>
                        </div>
                        <div class="kpi-tile-foot">
                            <span v-bind:class="['kpi-delta', methods.deltaClass(state.kpi.inboundDeltaPct)]">
                                <i v-bind:class="methods.deltaIcon(state.kpi.inboundDeltaPct)"></i>
                                {{ methods.formatDelta(state.kpi.inboundDeltaPct) }}
                            </span>
                            <span>vs daily average</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a v-bind:href="methods.outboundReportUrl()" class="kpi-tile-link" title="View today's outbound transactions">
                <div class="kpi-tile">
                    <div class="kpi-tile-icon" style="--kt-bg:rgba(249,115,22,.12); --kt-fg:#f97316;">
                        <i class="fas fa-arrow-up"></i>
                    </div>
                    <div>
                        <div class="kpi-tile-label">Outbound Today</div>
                        <div class="kpi-tile-value">
                            {{ methods.formatQty(state.kpi.outboundToday) }}
                            <i class="fas fa-chevron-right kpi-tile-cta"></i>
                        </div>
                        <div class="kpi-tile-foot">
                            <span v-bind:class="['kpi-delta', methods.deltaClass(state.kpi.outboundDeltaPct)]">
                                <i v-bind:class="methods.deltaIcon(state.kpi.outboundDeltaPct)"></i>
                                {{ methods.formatDelta(state.kpi.outboundDeltaPct) }}
                            </span>
                            <span>vs daily average</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a v-bind:href="methods.lowStockListUrl()" class="kpi-tile-link" title="View the low stock product list">
                <div class="kpi-tile">
                    <div class="kpi-tile-icon" style="--kt-bg:rgba(239,68,68,.12); --kt-fg:#ef4444;">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div>
                        <div class="kpi-tile-label">Low Stock Items</div>
                        <div class="kpi-tile-value">
                            {{ methods.formatQty(state.kpi.lowStockCount) }}
                            <i class="fas fa-chevron-right kpi-tile-cta"></i>
                        </div>
                        <div class="kpi-tile-foot">
                            <span v-bind:class="['kpi-delta', methods.deltaClass(state.kpi.lowStockDeltaPct, true)]">
                                <i v-bind:class="methods.deltaIcon(state.kpi.lowStockDeltaPct)"></i>
                                {{ methods.formatDelta(state.kpi.lowStockDeltaPct) }}
                            </span>
                            <span>at or below {{ methods.formatQty(state.kpi.lowStockThreshold) }} units</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- ── Fulfillment pipeline ─────────────────────────────── -->
    <div class="row g-3">
        <div class="col-sm-6 col-xl-6">
            <a href="/SalesOrders/SalesOrderList" class="kpi-tile-link" title="View sales orders awaiting delivery">
                <div class="kpi-tile">
                    <div class="kpi-tile-icon" style="--kt-bg:rgba(245,158,11,.12); --kt-fg:#f59e0b;">
                        <i class="fas fa-truck-loading"></i>
                    </div>
                    <div>
                        <div class="kpi-tile-label">Pending Delivery</div>
                        <div class="kpi-tile-value">
                            {{ methods.formatQty(state.kpi.pendingDeliveryCount) }}
                            <i class="fas fa-chevron-right kpi-tile-cta"></i>
                        </div>
                        <div class="kpi-tile-foot">
                            <span>units outstanding across {{ methods.formatQty(state.kpi.pendingDeliveryOrderCount) }} order(s)</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-6">
            <a href="/PurchaseOrders/PurchaseOrderList" class="kpi-tile-link" title="View purchase orders awaiting goods receipt">
                <div class="kpi-tile">
                    <div class="kpi-tile-icon" style="--kt-bg:rgba(6,182,212,.12); --kt-fg:#06b6d4;">
                        <i class="fas fa-inbox"></i>
                    </div>
                    <div>
                        <div class="kpi-tile-label">Pending Goods Received</div>
                        <div class="kpi-tile-value">
                            {{ methods.formatQty(state.kpi.pendingGoodsReceiveCount) }}
                            <i class="fas fa-chevron-right kpi-tile-cta"></i>
                        </div>
                        <div class="kpi-tile-foot">
                            <span>units outstanding across {{ methods.formatQty(state.kpi.pendingGoodsReceiveOrderCount) }} order(s)</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- ── Financial KPI tiles ──────────────────────────────── -->
    <div class="row g-3">
        <div class="col-sm-6 col-xl-3">
            <a v-bind:href="methods.inboundReportUrl()" class="kpi-tile-link" title="View today's purchase transactions">
                <div class="kpi-tile">
                    <div class="kpi-tile-icon" style="--kt-bg:rgba(139,92,246,.12); --kt-fg:#8b5cf6;">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <div>
                        <div class="kpi-tile-label">Today's Purchase</div>
                        <div class="kpi-tile-value">
                            {{ methods.formatCurrency(state.kpi.todayPurchaseAmount) }}
                            <i class="fas fa-chevron-right kpi-tile-cta"></i>
                        </div>
                        <div class="kpi-tile-foot">
                            <span>confirmed orders today</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a v-bind:href="methods.outboundReportUrl()" class="kpi-tile-link" title="View today's sales transactions">
                <div class="kpi-tile">
                    <div class="kpi-tile-icon" style="--kt-bg:rgba(236,72,153,.12); --kt-fg:#ec4899;">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </div>
                    <div>
                        <div class="kpi-tile-label">Today's Sales</div>
                        <div class="kpi-tile-value">
                            {{ methods.formatCurrency(state.kpi.todaySalesAmount) }}
                            <i class="fas fa-chevron-right kpi-tile-cta"></i>
                        </div>
                        <div class="kpi-tile-foot">
                            <span>confirmed orders today</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-tile">
                <div class="kpi-tile-icon" style="--kt-bg:rgba(34,197,94,.12); --kt-fg:#22c55e;">
                    <i class="fas fa-hand-holding-usd"></i>
                </div>
                <div>
                    <div class="kpi-tile-label">Today's Collections</div>
                    <div class="kpi-tile-value">
                        {{ methods.formatCurrency(state.kpi.todayDueAmount) }}
                    </div>
                    <div class="kpi-tile-foot">
                        <span>payments received today</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Inventory status + movement trend ────────────────── -->
    <div class="row g-3">
        <div class="col-12 col-xl-5">
            <div class="dash-panel">
                <div class="dash-ph">
                    <h2 class="dash-ph-title">Inventory Status</h2>
                    <a href="/StockReports/StockReportList" class="dash-ph-link">View Report</a>
                </div>
                <div class="donut-row">
                    <div class="donut-holder">
                        <div ref="statusChartRef"></div>
                        <div class="donut-center">
                            <div class="donut-center-value">{{ methods.formatQty(state.statusTotal) }}</div>
                            <div class="donut-center-label">Total Units</div>
                        </div>
                    </div>
                    <div class="donut-legend">
                        <div class="donut-legend-row" v-for="slice in state.inventoryStatus" v-bind:key="slice.label">
                            <span class="donut-dot" v-bind:style="{ background: slice.color }"></span>
                            <span class="donut-legend-name">{{ slice.label }}</span>
                            <span class="donut-legend-value">{{ methods.formatQty(slice.value) }}</span>
                            <span class="donut-legend-pct">({{ slice.percentage }}%)</span>
                        </div>
                        <div class="db-empty" v-if="state.inventoryStatus.length === 0">No inventory recorded yet.</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-7">
            <div class="dash-panel">
                <div class="dash-ph">
                    <h2 class="dash-ph-title">Inbound vs Outbound</h2>
                    <span class="dash-ph-pill">Last 7 Days</span>
                </div>
                <div ref="trendChartRef"></div>
            </div>
        </div>
    </div>

    <!-- ── Top categories + recent activity ─────────────────── -->
    <div class="row g-3">
        <div class="col-12 col-xl-5">
            <div class="dash-panel">
                <div class="dash-ph">
                    <h2 class="dash-ph-title">Top Categories</h2>
                    <a href="/ProductGroups/ProductGroupList" class="dash-ph-link">View All</a>
                </div>
                <div class="cat-list">
                    <div v-for="category in state.topCategories" v-bind:key="category.name">
                        <div class="cat-head">
                            <span class="cat-name">{{ category.name }}</span>
                            <span>
                                <span class="cat-value">{{ methods.formatQty(category.quantity) }}</span>
                                <span class="cat-pct">({{ category.percentage }}%)</span>
                            </span>
                        </div>
                        <div class="cat-track">
                            <div class="cat-fill" v-bind:style="{ width: category.percentage + '%' }"></div>
                        </div>
                    </div>
                    <div class="db-empty" v-if="state.topCategories.length === 0">No stock on hand yet.</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-7">
            <div class="dash-panel">
                <div class="dash-ph">
                    <h2 class="dash-ph-title">Recent Activities</h2>
                    <a href="/TransactionReports/TransactionReportList" class="dash-ph-link">View All</a>
                </div>
                <div class="act-list">
                    <div class="act-row" v-for="activity in state.recentActivities" v-bind:key="activity.key">
                        <span v-bind:class="['act-icon', activity.direction === 'In' ? 'in' : 'out']">
                            <i v-bind:class="activity.direction === 'In' ? 'fas fa-arrow-down' : 'fas fa-arrow-up'"></i>
                        </span>
                        <span class="act-title">
                            <span>{{ activity.title }}</span>
                            <span class="act-qty">{{ methods.formatQty(activity.quantity) }} units</span>
                        </span>
                        <span class="act-number">{{ activity.number }}</span>
                        <span class="act-time">{{ activity.timeLabel }}</span>
                    </div>
                    <div class="db-empty" v-if="state.recentActivities.length === 0">No recent movements.</div>
                </div>
            </div>
        </div>
    </div>

</div>
</div>
</div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Dashboards/DefaultDashboard.cshtml.js"></script>
}
