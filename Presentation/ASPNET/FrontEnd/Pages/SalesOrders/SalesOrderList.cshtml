@page
@{
    ViewData["Title"] = "Sales Order List";
}

@section styles {
    <link rel="stylesheet" href="~/css/order-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pos-order-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/order-view-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/purchase-order-list.css" asp-append-version="true" />
}

<div id="app" v-cloak>
    <div class="page-head">
        <div>
            <h1 class="page-head-title">Sales Orders</h1>
            <p class="page-head-sub">Create orders, track their status and collect customer payments.</p>
        </div>
    </div>

    <div class="stat-strip">
        <div class="stat-tile">
            <div class="stat-tile-label"><i class="fas fa-file-invoice"></i>Total Orders</div>
            <div class="stat-tile-value">{{ listStats.total }}</div>
        </div>
        <div class="stat-tile">
            <div class="stat-tile-label"><i class="fas fa-pencil-alt"></i>Draft</div>
            <div class="stat-tile-value">{{ listStats.draft }}</div>
        </div>
        <div class="stat-tile">
            <div class="stat-tile-label"><i class="fas fa-check-circle"></i>Confirmed</div>
            <div class="stat-tile-value">{{ listStats.confirmed }}</div>
        </div>
        <div class="stat-tile">
            <div class="stat-tile-label"><i class="fas fa-coins"></i>Confirmed Value</div>
            <div class="stat-tile-value">{{ handler.formatAmount(listStats.confirmedValue) }}</div>
        </div>
    </div>

    <div class="list-card grid-container po-grid-wrap">
        <!-- Filter panel — toggled by the Filter button in the grid toolbar. Live filtering:
             each control change re-filters the list instantly (no Apply button needed). -->
        <div ref="filterPanelRef" class="po-filter-panel" v-show="state.filterOpen" role="region" aria-label="Sales order filters">
            <div class="po-filter-panel__header">
                <span class="po-filter-panel__title">
                    <i class="fas fa-filter"></i>Filters
                    <span class="po-filter-panel__count" v-if="activeFilterCount">{{ activeFilterCount }}</span>
                </span>
                <div class="po-filter-panel__header-actions">
                    <button type="button" class="btn btn-sm btn-link po-filter-clear" v-on:click="handler.clearFilters" v-bind:disabled="!activeFilterCount">
                        <i class="fas fa-times-circle"></i><span>Clear all</span>
                    </button>
                    <button type="button" class="btn-close po-filter-close" aria-label="Close filters" v-on:click="handler.toggleFilter"></button>
                </div>
            </div>
            <div class="po-filter-panel__body">
                <div class="po-filter-field">
                    <label class="po-filter-label">Status</label>
                    <div ref="filterStatusRef"></div>
                </div>
                <div class="po-filter-field">
                    <label class="po-filter-label">Customer</label>
                    <div ref="filterCustomerRef"></div>
                </div>
                <div class="po-filter-field">
                    <label class="po-filter-label">Tax</label>
                    <div ref="filterTaxRef"></div>
                </div>
                <div class="po-filter-field">
                    <label class="po-filter-label">Created From</label>
                    <div ref="filterFromDateRef"></div>
                </div>
                <div class="po-filter-field">
                    <label class="po-filter-label">Created To</label>
                    <div ref="filterToDateRef"></div>
                </div>
            </div>
        </div>

        <div ref="mainGridRef" id="MainGrid"></div>
    </div>

    <div class="modal fade pos-modal" ref="mainModalRef" id="MainModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header pos-header">
                    <div class="pos-header-title">
                        <span class="pos-header-icon" v-bind:class="{ 'is-danger': state.deleteMode }">
                            <i v-bind:class="state.deleteMode ? 'fas fa-trash' : 'fas fa-cash-register'"></i>
                        </span>
                        <div>
                            <h5 class="modal-title">{{ state.mainTitle }}</h5>
                            <div class="pos-header-meta">
                                <span v-if="state.number">{{ state.number }}</span>
                                <span v-else>Number is assigned when the order is first saved</span>
                                <span class="pos-dot" v-if="state.secondaryData.length"></span>
                                <span v-if="state.secondaryData.length">{{ state.secondaryData.length }} item(s)</span>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pos-body">
                    <input type="hidden" v-model="state.id" id="Id" name="Id" />

                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" v-if="state.deleteMode">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>You are about to delete Sales Order <strong>{{ state.number }}</strong> and its {{ state.secondaryData.length }} line item(s). This cannot be undone.</span>
                    </div>

                    <!-- Order details (always rendered so the Syncfusion inputs keep their host nodes) -->
                    <form id="MainForm" class="card pos-section" v-on:submit.prevent>
                        <div class="card-header">
                            <h6 class="pos-section-title"><i class="fas fa-file-alt"></i>Order Details</h6>
                        </div>
                        <div class="card-body">
                            <div class="pos-fields">
                                <div>
                                    <label for="CustomerId" class="pos-field-label">Customer<span class="pos-req">*</span></label>
                                    <div class="pos-field-with-action">
                                        <div ref="customerIdRef"></div>
                                        <button type="button"
                                                class="btn btn-outline-primary pos-icon-btn"
                                                v-on:click="handler.openCustomerQuickCreate"
                                                v-bind:disabled="state.deleteMode"
                                                title="Quick-create a new customer"
                                                aria-label="Quick-create a new customer">
                                            <i class="fas fa-user-plus"></i>
                                        </button>
                                    </div>
                                    <div class="pos-field-error" v-if="state.errors.customerId">{{ state.errors.customerId }}</div>
                                </div>
                                <div>
                                    <label for="OrderDate" class="pos-field-label">Order Date<span class="pos-req">*</span></label>
                                    <input ref="orderDateRef" />
                                    <div class="pos-field-error" v-if="state.errors.orderDate">{{ state.errors.orderDate }}</div>
                                </div>
                                <div>
                                    <label for="OrderStatus" class="pos-field-label">Status<span class="pos-req">*</span></label>
                                    <div ref="orderStatusRef"></div>
                                    <div class="pos-field-error" v-if="state.errors.orderStatus">{{ state.errors.orderStatus }}</div>
                                </div>
                                <div>
                                    <label for="TaxId" class="pos-field-label">Tax<span class="pos-req">*</span></label>
                                    <div class="pos-field-with-action">
                                        <div ref="taxIdRef"></div>
                                        <button type="button"
                                                class="btn btn-outline-primary pos-icon-btn"
                                                v-on:click="handler.openTaxQuickCreate"
                                                v-bind:disabled="state.deleteMode"
                                                title="Quick-create a new tax"
                                                aria-label="Quick-create a new tax">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                    <div class="pos-field-error" v-if="state.errors.taxId">{{ state.errors.taxId }}</div>
                                </div>
                                <div class="pos-span-all">
                                    <label for="Description" class="pos-field-label">Note</label>
                                    <textarea id="Description" class="form-control" rows="1" v-model="state.description" placeholder="Optional note for this order"></textarea>
                                </div>
                            </div>
                        </div>
                    </form>

                    <!-- POS working area -->
                    <div class="row g-3" v-show="!state.deleteMode">
                        <!-- LEFT: product entry + cart -->
                        <div class="col-lg-8">
                            <div class="card pos-section pos-card">
                                <div class="card-header">
                                    <h6 class="pos-section-title"><i class="fas fa-box-open"></i>Add Products</h6>
                                    <button type="button" class="pos-link-btn" v-on:click="handler.clearProductPick" v-bind:disabled="!state.productHint.name">
                                        <i class="fas fa-undo me-1"></i>Reset
                                    </button>
                                </div>
                                <div class="card-body pos-pick">
                                    <label class="pos-field-label">Product</label>
                                    <div ref="productPickRef"></div>

                                    <div class="pos-entry mt-3">
                                        <div>
                                            <label class="pos-field-label">Unit Price</label>
                                            <input type="number" step="0.01" min="0"
                                                   class="form-control text-end"
                                                   v-model.number="state.productPick.unitPrice">
                                        </div>
                                        <div>
                                            <label class="pos-field-label">Quantity</label>
                                            <div class="input-group pos-qty">
                                                <div class="input-group-prepend">
                                                    <button type="button" class="btn btn-outline-secondary" v-on:click="handler.stepQty(-1)" aria-label="Decrease quantity"><i class="fas fa-minus"></i></button>
                                                </div>
                                                <input type="number" step="any" min="0" class="form-control" v-model.number="state.productPick.quantity">
                                                <div class="input-group-append">
                                                    <button type="button" class="btn btn-outline-secondary" v-on:click="handler.stepQty(1)" aria-label="Increase quantity"><i class="fas fa-plus"></i></button>
                                                </div>
                                            </div>
                                        </div>
                                        <div>
                                            <label class="pos-field-label">Line Total</label>
                                            <input type="text" class="form-control text-end pos-line-total" readonly
                                                   v-bind:value="handler.formatAmount(posLineTotal)">
                                        </div>
                                        <button type="button" class="btn btn-primary pos-add-btn"
                                                v-on:click="handler.addLineToCart"
                                                v-bind:disabled="state.isAddingLine || !state.productPick.productId">
                                            <span class="spinner-border spinner-border-sm me-2" v-if="state.isAddingLine" role="status" aria-hidden="true"></span>
                                            <i class="fas fa-cart-plus me-2" v-else></i>Add to Cart
                                        </button>
                                    </div>

                                    <div class="pos-hints" v-if="state.productHint.name">
                                        <span v-if="state.productHint.physical" class="pos-hint" v-bind:class="{ 'is-danger': posStockExceeded }">
                                            <i class="fas fa-warehouse"></i>In stock: {{ handler.formatQty(state.productHint.stock) }}
                                        </span>
                                        <span v-else class="pos-hint"><i class="fas fa-infinity"></i>Non-stock item</span>
                                        <span class="pos-hint" v-if="state.productHint.minPrice !== null || state.productHint.maxPrice !== null"
                                              v-bind:class="{ 'is-danger': posPriceOutOfBand }">
                                            <i class="fas fa-tag"></i>Price range {{ handler.formatAmount(state.productHint.minPrice || 0) }} &ndash; {{ state.productHint.maxPrice !== null ? handler.formatAmount(state.productHint.maxPrice) : 'no max' }}
                                        </span>
                                    </div>

                                    <div class="pos-divider-label">or scan</div>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                                        </div>
                                        <input ref="barcodeScanRef"
                                               v-model="state.barcodeInput"
                                               type="text"
                                               class="form-control"
                                               placeholder="Scan a barcode or type a SKU, then press Enter"
                                               aria-label="Barcode or SKU"
                                               v-on:keydown.enter.prevent="handler.handleBarcodeInput"
                                               autocomplete="off" />
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-outline-secondary" v-on:click="handler.handleBarcodeInput" title="Add product by barcode">
                                                Add
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card pos-section pos-card mb-0">
                                <div class="card-header">
                                    <h6 class="pos-section-title"><i class="fas fa-shopping-cart"></i>Cart <span class="pos-count">{{ state.secondaryData.length }}</span></h6>
                                    <button type="button" class="pos-link-btn is-danger"
                                            v-on:click="handler.clearCart"
                                            v-bind:disabled="!state.secondaryData.length">
                                        <i class="fas fa-trash-alt me-1"></i>Clear all
                                    </button>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table pos-cart">
                                            <thead>
                                                <tr>
                                                    <th>Product</th>
                                                    <th class="text-center" style="width:136px;">Qty</th>
                                                    <th class="text-end" style="width:128px;">Unit Price</th>
                                                    <th class="text-end" style="width:120px;">Total</th>
                                                    <th style="width:48px;"><span class="sr-only">Remove</span></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr v-if="!state.secondaryData.length">
                                                    <td colspan="5">
                                                        <div class="pos-empty">
                                                            <i class="fas fa-shopping-basket"></i>
                                                            <strong>Your cart is empty</strong>
                                                            <span>Search for a product or scan a barcode to add it.</span>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr v-for="line in state.secondaryData" v-bind:key="line.id">
                                                    <td>
                                                        <div class="pos-cart-product">{{ line.productName }}</div>
                                                        <div class="pos-cart-sku">{{ line.productNumber }}</div>
                                                    </td>
                                                    <td>
                                                        <div class="input-group input-group-sm pos-qty">
                                                            <div class="input-group-prepend">
                                                                <button type="button" class="btn btn-outline-secondary" v-on:click="handler.stepLineQty(line, -1)" aria-label="Decrease quantity"><i class="fas fa-minus"></i></button>
                                                            </div>
                                                            <input type="number" step="any" min="0" class="form-control"
                                                                   aria-label="Quantity"
                                                                   v-bind:value="line.quantity"
                                                                   v-on:change="handler.commitLineQty(line, $event.target.value)">
                                                            <div class="input-group-append">
                                                                <button type="button" class="btn btn-outline-secondary" v-on:click="handler.stepLineQty(line, 1)" aria-label="Increase quantity"><i class="fas fa-plus"></i></button>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="text-end">
                                                        <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end pos-line-price"
                                                               aria-label="Unit price"
                                                               v-bind:value="line.unitPrice"
                                                               v-on:change="handler.commitLinePrice(line, $event.target.value)">
                                                    </td>
                                                    <td class="text-end fw-semibold">{{ handler.formatAmount((line.unitPrice || 0) * (line.quantity || 0)) }}</td>
                                                    <td class="text-center">
                                                        <button type="button" class="pos-remove-btn" v-on:click="handler.removeLine(line)" title="Remove item" aria-label="Remove item">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT: summary + payments -->
                        <div class="col-lg-4">
                            <div class="pos-side">
                                <div class="card pos-section">
                                    <div class="card-header">
                                        <h6 class="pos-section-title"><i class="fas fa-receipt"></i>Summary</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="pos-summary-row">
                                            <span class="text-muted">Subtotal</span>
                                            <span id="SubTotalAmount">{{ state.subTotalAmount }}</span>
                                        </div>
                                        <div class="pos-summary-row">
                                            <span class="text-muted">Tax</span>
                                            <span id="TaxAmount">{{ state.taxAmount }}</span>
                                        </div>
                                        <div class="pos-total-block">
                                            <div class="pos-total-label">Total</div>
                                            <div class="pos-total-value" id="TotalAmount">{{ state.totalAmount }}</div>
                                            <div class="pos-total-words" id="AmountInWords" v-if="state.amountInWords">{{ state.amountInWords }}</div>
                                        </div>
                                        <div class="pos-summary-row" v-if="state.paymentSummary">
                                            <span class="text-muted">Paid</span>
                                            <span id="AmountPaid">{{ handler.formatAmount(state.paymentSummary.amountPaid) }}</span>
                                        </div>
                                        <div class="pos-balance" v-if="state.paymentSummary"
                                             v-bind:class="state.isFullySettled ? 'is-settled' : 'is-due'">
                                            <span><i class="fas me-2" v-bind:class="state.isFullySettled ? 'fa-check-circle' : 'fa-clock'"></i>{{ state.isFullySettled ? 'Fully settled' : 'Balance due' }}</span>
                                            <span id="AmountOutstanding">{{ handler.formatAmount(state.paymentSummary.amountOutstanding) }}</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="card pos-section mb-0">
                                    <div class="card-header">
                                        <h6 class="pos-section-title"><i class="fas fa-hand-holding-usd"></i>Payments <span class="pos-count" v-if="state.paymentList.length">{{ state.paymentList.length }}</span></h6>
                                    </div>
                                    <div class="card-body">
                                        <p class="pos-note" v-if="!state.id">
                                            Add a product to create the order, then record payments here.
                                        </p>

                                        <ul class="pos-pay-list" v-if="state.paymentList.length">
                                            <li class="pos-pay-item" v-for="p in state.paymentList" v-bind:key="p.id">
                                                <div class="pos-pay-main">
                                                    <div class="pos-pay-method">{{ p.paymentMethodName }}</div>
                                                    <div class="pos-pay-date">{{ handler.formatPaymentDate(p.paymentDate) }}</div>
                                                </div>
                                                <span class="pos-pay-amount">{{ handler.formatAmount(p.amount) }}</span>
                                                <button type="button"
                                                        class="pos-remove-btn"
                                                        v-on:click="handler.deletePayment(p)"
                                                        v-bind:disabled="state.deleteMode || state.isPaymentSubmitting"
                                                        title="Remove this payment"
                                                        aria-label="Remove this payment">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </li>
                                        </ul>
                                        <p class="pos-note mb-3" v-else-if="state.id">No payments recorded yet.</p>

                                        <div v-if="!state.deleteMode && state.id && !state.isFullySettled">
                                            <div class="pos-pay-form">
                                                <div>
                                                    <label class="pos-field-label">Date</label>
                                                    <input ref="paymentDateRef">
                                                </div>
                                                <div>
                                                    <label class="pos-field-label">Method</label>
                                                    <select class="form-select" v-model="state.newPayment.paymentMethodId">
                                                        <option value="">Select...</option>
                                                        <option v-for="m in state.paymentMethodListLookupData" v-bind:key="m.id" v-bind:value="m.id">{{ m.name }}</option>
                                                    </select>
                                                </div>
                                                <div>
                                                    <label class="pos-field-label">Amount</label>
                                                    <input type="number" step="0.01" min="0" class="form-control text-end"
                                                           v-model.number="state.newPayment.amount"
                                                           v-bind:placeholder="handler.formatAmount(state.paymentSummary ? state.paymentSummary.amountOutstanding : 0)">
                                                </div>
                                                <div>
                                                    <label class="pos-field-label">Reference</label>
                                                    <input type="text" class="form-control" v-model="state.newPayment.referenceNumber" placeholder="Optional">
                                                </div>
                                            </div>
                                            <div class="pos-pay-actions">
                                                <button type="button" class="btn btn-success"
                                                        v-on:click="handler.submitPayment"
                                                        v-bind:disabled="state.isPaymentSubmitting">
                                                    <span class="spinner-border spinner-border-sm me-2" v-if="state.isPaymentSubmitting" role="status" aria-hidden="true"></span>
                                                    <i class="fas fa-check me-2" v-else></i>Record Payment
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary"
                                                        v-on:click="handler.payFullBalance"
                                                        v-bind:disabled="state.isPaymentSubmitting"
                                                        title="Fill the amount with the outstanding balance">
                                                    Pay full balance
                                                </button>
                                            </div>
                                        </div>
                                        <p class="pos-note is-danger mt-2" v-if="state.paymentError">{{ state.paymentError }}</p>
                                        <p class="pos-note is-success" v-if="state.isFullySettled"><i class="fas fa-check-circle me-2"></i>This order is fully settled.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer pos-footer">
                    <div class="pos-footer-summary" v-if="!state.deleteMode">
                        {{ state.secondaryData.length }} item(s) &middot; Total <strong>{{ state.totalAmount }}</strong>
                    </div>
                    <div class="pos-footer-actions">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button"
                                id="MainSaveButton"
                                class="btn"
                                v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                                v-on:click="handler.handleSubmit"
                                v-bind:disabled="state.isSubmitting">
                            <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                            <i v-if="!state.isSubmitting" v-bind:class="state.deleteMode ? 'fas fa-trash me-2' : 'fas fa-save me-2'"></i><span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Delete Order' : 'Save Order' }}</span>
                            <span v-else>{{ state.deleteMode ? 'Deleting...' : 'Saving...' }}</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- View Sales Order Modal -->
    <div class="modal fade order-view-modal" ref="viewModalRef" id="ViewSalesOrderModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <div class="ov-title-row">
                            <h5>{{ state.view.number || 'Sales Order Details' }}</h5>
                            <span class="ov-number-badge" v-if="state.view.number">{{ state.view.number }}</span>
                        </div>
                        <div class="ov-badges">
                            <span v-bind:class="state.view.statusClass">{{ state.view.orderStatusName || '—' }}</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="ov-facts">
                        <div class="ov-fact">
                            <span class="ov-fact-label">Customer</span>
                            <span class="ov-fact-value">{{ state.view.customerName || '—' }}</span>
                        </div>
                        <div class="ov-fact">
                            <span class="ov-fact-label">Order Date</span>
                            <span class="ov-fact-value">{{ handler.formatDate(state.view.orderDate) }}</span>
                        </div>
                        <div class="ov-fact">
                            <span class="ov-fact-label">Tax</span>
                            <span class="ov-fact-value">{{ state.view.taxName || '—' }}</span>
                        </div>
                        <div class="ov-fact">
                            <span class="ov-fact-label">Description</span>
                            <span class="ov-fact-value">{{ state.view.description || '—' }}</span>
                        </div>
                    </div>

                    <h6 class="ov-section-title"><i class="fas fa-list me-2"></i>Line Items</h6>
                    <div class="table-responsive" v-if="state.view.items.length">
                        <table class="table table-sm ov-items-table mb-0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="item in state.view.items" v-bind:key="item.id">
                                    <td>{{ item.productName || '—' }}</td>
                                    <td class="text-end">{{ handler.formatAmount(item.unitPrice) }}</td>
                                    <td class="text-end">{{ handler.formatQty(item.quantity) }}</td>
                                    <td class="text-end fw-semibold">{{ handler.formatAmount(item.total) }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <p v-else class="text-muted small mb-0">No line items.</p>

                    <div class="ov-totals">
                        <div class="ov-fact">
                            <span class="ov-fact-label">Sub Total</span>
                            <span class="ov-fact-value">{{ handler.formatAmount(state.view.beforeTaxAmount) }}</span>
                        </div>
                        <div class="ov-fact">
                            <span class="ov-fact-label">Tax Amount</span>
                            <span class="ov-fact-value">{{ handler.formatAmount(state.view.taxAmount) }}</span>
                        </div>
                        <div class="ov-fact">
                            <span class="ov-fact-label">Total Amount</span>
                            <span class="ov-total-amount">{{ handler.formatAmount(state.view.afterTaxAmount) }}</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Close
                    </button>
                    <button type="button" class="btn btn-primary" v-on:click="handler.editFromView">
                        <i class="fas fa-edit me-2"></i>Edit Order
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Customer Quick Create Modal -->
    <div class="modal fade" ref="customerQuickModalRef" id="CustomerQuickModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-user-plus me-2"></i>Quick Create Customer</h5>
                    <button type="button" class="btn-close" v-on:click="handler.closeCustomerQuickCreate" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3"><i class="fas fa-info-circle me-2"></i>Only Name and Phone are required. The new customer will be automatically selected after creation.</p>
                    <div class="card mb-3">
                        <div class="card-header"><h6 class="mb-0"><i class="fas fa-info-circle me-2 text-primary"></i>Basic Info</h6></div>
                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <label>Name <span class="text-danger">*</span></label>
                                    <input v-model="state.customerQuickName" type="text" class="form-control" placeholder="Customer name" />
                                    <span class="text-danger small">{{ state.customerQuickErrors.name }}</span>
                                </div>
                                <div class="col-md-6">
                                    <label>Description</label>
                                    <input v-model="state.customerQuickDescription" type="text" class="form-control" placeholder="Optional" />
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <label>Customer Group</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <div ref="customerQuickGroupIdRef" class="flex-grow-1"></div>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-success flex-shrink-0"
                                                v-on:click="handler.openCustomerGroupQuickCreate"
                                                title="Quick-create a new customer group">
                                            <i class="fas fa-plus me-2"></i>New
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label>Customer Category</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <div ref="customerQuickCategoryIdRef" class="flex-grow-1"></div>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-warning flex-shrink-0"
                                                v-on:click="handler.openCustomerCategoryQuickCreate"
                                                title="Quick-create a new customer category">
                                            <i class="fas fa-plus me-2"></i>New
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card mb-3">
                        <div class="card-header"><h6 class="mb-0"><i class="fas fa-map-marker-alt me-2 text-primary"></i>Address</h6></div>
                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col-md-12">
                                    <label>Street</label>
                                    <input v-model="state.customerQuickStreet" type="text" class="form-control" placeholder="Street address (optional)" />
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-4">
                                    <label>City</label>
                                    <input v-model="state.customerQuickCity" type="text" class="form-control" placeholder="City (optional)" />
                                </div>
                                <div class="col-md-4">
                                    <label>State / Province</label>
                                    <input v-model="state.customerQuickAddrState" type="text" class="form-control" placeholder="State / Province (optional)" />
                                </div>
                                <div class="col-md-4">
                                    <label>Zip Code</label>
                                    <input v-model="state.customerQuickZipCode" type="text" class="form-control" placeholder="Zip / Postal code (optional)" />
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-12">
                                    <label>Country</label>
                                    <input v-model="state.customerQuickCountry" type="text" class="form-control" placeholder="Country (optional)" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-header"><h6 class="mb-0"><i class="fas fa-phone me-2 text-primary"></i>Contact</h6></div>
                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <label>Phone Number <span class="text-danger">*</span></label>
                                    <input v-model="state.customerQuickPhoneNumber" type="text" class="form-control" maxlength="15" placeholder="Phone number" />
                                    <span class="text-danger small">{{ state.customerQuickErrors.phoneNumber }}</span>
                                </div>
                                <div class="col-md-6">
                                    <label>Email Address</label>
                                    <input v-model="state.customerQuickEmailAddress" type="email" class="form-control" placeholder="Email (optional)" />
                                    <span class="text-danger small">{{ state.customerQuickErrors.emailAddress }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" v-on:click="handler.closeCustomerQuickCreate"><i class="fas fa-times me-2"></i>Cancel</button>
                    <button type="button" class="btn btn-primary" v-on:click="handler.submitCustomerQuickCreate" v-bind:disabled="state.customerQuickIsSubmitting">
                        <span class="spinner-border spinner-border-sm me-1" v-if="state.customerQuickIsSubmitting"></span>
                        <i class="fas fa-user-plus me-2" v-else></i>
                        {{ state.customerQuickIsSubmitting ? 'Creating...' : 'Create & Select' }}
                    </button>
                </div>
            </div>
        </div>
    </div>

