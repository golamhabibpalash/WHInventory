@page
@{
    ViewData["Title"] = "Sales Order List";
}

@section styles {
    <link rel="stylesheet" href="~/css/pos-order-modal.css" asp-append-version="true" />
}

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div ref="mainGridRef" id="MainGrid"></div>
            </div>
        </div>
    </div>

    <div class="modal fade pos-modal" ref="mainModalRef" id="MainModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-cash-register me-2 text-primary"></i>{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" v-model="state.id" id="Id" name="Id" />

                    <!-- Order-detail bar (always rendered so the Syncfusion inputs keep their host nodes) -->
                    <form id="MainForm" class="card pos-orderbar mb-3">
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label for="CustomerId" class="form-label">Customer <span class="text-danger">*</span></label>
                                    <div class="d-flex align-items-center gap-2">
                                        <div ref="customerIdRef" class="flex-grow-1"></div>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary flex-shrink-0"
                                                v-on:click="handler.openCustomerQuickCreate"
                                                v-bind:disabled="state.deleteMode"
                                                title="Quick-create a new customer">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                    <div class="text-danger small mt-1" v-if="state.errors.customerId">{{ state.errors.customerId }}</div>
                                </div>
                                <div class="col-md-2">
                                    <label for="OrderDate" class="form-label">Order Date</label>
                                    <input ref="orderDateRef" />
                                    <div class="text-danger small mt-1" v-if="state.errors.orderDate">{{ state.errors.orderDate }}</div>
                                </div>
                                <div class="col-md-2">
                                    <label for="Number" class="form-label">Number</label>
                                    <input ref="numberRef" v-model="state.number" readonly>
                                </div>
                                <div class="col-md-3">
                                    <label for="TaxId" class="form-label">Tax <span class="text-danger">*</span></label>
                                    <div class="d-flex align-items-center gap-2">
                                        <div ref="taxIdRef" class="flex-grow-1"></div>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary flex-shrink-0"
                                                v-on:click="handler.openTaxQuickCreate"
                                                v-bind:disabled="state.deleteMode"
                                                title="Quick-create a new tax">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                    <div class="text-danger small mt-1" v-if="state.errors.taxId">{{ state.errors.taxId }}</div>
                                </div>
                                <div class="col-md-2">
                                    <label for="OrderStatus" class="form-label">Status <span class="text-danger">*</span></label>
                                    <div ref="orderStatusRef"></div>
                                    <div class="text-danger small mt-1" v-if="state.errors.orderStatus">{{ state.errors.orderStatus }}</div>
                                </div>
                                <div class="col-12">
                                    <label for="Description" class="form-label">Description</label>
                                    <textarea class="form-control" rows="1" v-model="state.description"></textarea>
                                </div>
                            </div>
                        </div>
                    </form>

                    <div class="alert alert-danger d-flex align-items-center gap-2" v-if="state.deleteMode">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>You are about to delete Sales Order <strong>{{ state.number }}</strong> and its {{ state.secondaryData.length }} line item(s). This cannot be undone.</span>
                    </div>

                    <!-- POS working area -->
                    <div class="row g-3" v-show="!state.deleteMode">
                        <!-- LEFT: product picker + cart -->
                        <div class="col-lg-7">
                            <div class="card pos-card mb-3">
                                <div class="card-header">
                                    <h6><i class="fas fa-box-open me-2"></i>Select Product</h6>
                                </div>
                                <div class="card-body pos-pick">
                                    <div class="mb-3">
                                        <label class="form-label">Product</label>
                                        <div ref="productPickRef"></div>
                                    </div>
                                    <div class="row g-3 align-items-end mb-2">
                                        <div class="col-4">
                                            <label class="form-label">Unit Price</label>
                                            <input type="number" step="0.01" min="0"
                                                   class="form-control text-end"
                                                   v-model.number="state.productPick.unitPrice">
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label">Qty</label>
                                            <div class="input-group pos-qty">
                                                <button type="button" class="btn btn-outline-secondary" v-on:click="handler.stepQty(-1)" aria-label="Decrease quantity">&minus;</button>
                                                <input type="number" step="any" min="0" class="form-control" v-model.number="state.productPick.quantity">
                                                <button type="button" class="btn btn-outline-secondary" v-on:click="handler.stepQty(1)" aria-label="Increase quantity">+</button>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label">Line Total</label>
                                            <input type="text" class="form-control text-end pos-line-total" readonly
                                                   v-bind:value="handler.formatAmount(posLineTotal)">
                                        </div>
                                    </div>
                                    <div class="small mb-3" v-if="state.productHint.name">
                                        <span v-if="state.productHint.physical"
                                              v-bind:class="posStockExceeded ? 'text-danger fw-semibold' : 'text-muted'">
                                            <i class="fas fa-warehouse me-2"></i>Available: {{ handler.formatQty(state.productHint.stock) }}
                                        </span>
                                        <span v-else class="text-muted"><i class="fas fa-infinity me-2"></i>Non-stock item</span>
                                        <span v-if="posPriceOutOfBand" class="text-danger ms-2">
                                            <i class="fas fa-tag me-2"></i>Price outside {{ handler.formatAmount(state.productHint.minPrice || 0) }} &ndash; {{ handler.formatAmount(state.productHint.maxPrice || 0) }}
                                        </span>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-primary flex-grow-1"
                                                v-on:click="handler.addLineToCart"
                                                v-bind:disabled="state.isAddingLine">
                                            <span class="spinner-border spinner-border-sm me-2" v-if="state.isAddingLine" role="status" aria-hidden="true"></span>
                                            <i class="fas fa-cart-plus me-2" v-else></i>Add to Cart
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" v-on:click="handler.clearProductPick">Clear</button>
                                    </div>
                                    <div class="input-group mt-3">
                                        <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                                        <input ref="barcodeScanRef"
                                               v-model="state.barcodeInput"
                                               type="text"
                                               class="form-control"
                                               placeholder="Scan barcode / SKU and press Enter"
                                               v-on:keydown.enter.prevent="handler.handleBarcodeInput"
                                               autocomplete="off" />
                                        <button type="button" class="btn btn-outline-secondary" v-on:click="handler.handleBarcodeInput" title="Add product by barcode">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="card pos-card">
                                <div class="card-header">
                                    <h6><i class="fas fa-shopping-cart me-2"></i>Cart Items ({{ state.secondaryData.length }})</h6>
                                    <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none p-0"
                                            v-on:click="handler.clearCart"
                                            v-bind:disabled="!state.secondaryData.length">Clear all</button>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table pos-cart align-middle">
                                            <thead>
                                                <tr>
                                                    <th>Product</th>
                                                    <th class="text-center" style="width:132px;">Qty</th>
                                                    <th class="text-end" style="width:120px;">Unit Price</th>
                                                    <th class="text-end" style="width:110px;">Total</th>
                                                    <th style="width:44px;"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr v-if="!state.secondaryData.length">
                                                    <td colspan="5">
                                                        <div class="pos-cart-empty">Cart is empty &mdash; search and add a product above</div>
                                                    </td>
                                                </tr>
                                                <tr v-for="line in state.secondaryData" v-bind:key="line.id">
                                                    <td>
                                                        <div class="fw-semibold">{{ line.productName }}</div>
                                                        <div class="text-muted small">{{ line.productNumber }}</div>
                                                    </td>
                                                    <td>
                                                        <div class="input-group input-group-sm pos-qty">
                                                            <button type="button" class="btn btn-outline-secondary" v-on:click="handler.stepLineQty(line, -1)" aria-label="Decrease quantity">&minus;</button>
                                                            <input type="number" step="any" min="0" class="form-control"
                                                                   v-bind:value="line.quantity"
                                                                   v-on:change="handler.commitLineQty(line, $event.target.value)">
                                                            <button type="button" class="btn btn-outline-secondary" v-on:click="handler.stepLineQty(line, 1)" aria-label="Increase quantity">+</button>
                                                        </div>
                                                    </td>
                                                    <td class="text-end">
                                                        <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end"
                                                               v-bind:value="line.unitPrice"
                                                               v-on:change="handler.commitLinePrice(line, $event.target.value)">
                                                    </td>
                                                    <td class="text-end fw-semibold">{{ handler.formatAmount((line.unitPrice || 0) * (line.quantity || 0)) }}</td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn btn-sm btn-link text-danger p-0" v-on:click="handler.removeLine(line)" title="Remove item">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT: bill + payments -->
                        <div class="col-lg-5">
                            <div class="card pos-card mb-3">
                                <div class="card-header">
                                    <h6><i class="fas fa-receipt me-2"></i>Bill</h6>
                                    <span class="badge bg-light text-dark border" v-if="state.number">{{ state.number }}</span>
                                </div>
                                <div class="card-body">
                                    <div class="pos-summary-row">
                                        <span class="text-muted">Subtotal</span>
                                        <span id="SubTotalAmount">{{ state.subTotalAmount }}</span>
                                    </div>
                                    <div class="pos-summary-row">
                                        <span class="text-muted">Tax</span>
                                        <span id="TaxAmount">{{ state.taxAmount }}</span>
                                    </div>
                                    <div class="pos-summary-row pos-summary-total">
                                        <span>Total</span>
                                        <span id="TotalAmount" class="text-success">{{ state.totalAmount }}</span>
                                    </div>
                                    <div class="pos-summary-row" v-if="state.paymentSummary">
                                        <span class="text-muted">Paid</span>
                                        <span id="AmountPaid">{{ handler.formatAmount(state.paymentSummary.amountPaid) }}</span>
                                    </div>
                                    <div class="pos-summary-row" v-if="state.paymentSummary">
                                        <span class="fw-semibold">Balance Due</span>
                                        <span id="AmountOutstanding"
                                              class="fw-semibold"
                                              v-bind:class="state.isFullySettled ? 'text-success' : 'text-danger'">
                                            {{ handler.formatAmount(state.paymentSummary.amountOutstanding) }}
                                        </span>
                                    </div>
                                    <div class="mt-2 pt-2 border-top" v-if="state.amountInWords">
                                        <div class="text-muted small fw-semibold">Amount in Words</div>
                                        <div id="AmountInWords" class="fst-italic text-muted small">{{ state.amountInWords }}</div>
                                    </div>
                                </div>
                            </div>

                            <div class="card pos-card">
                                <div class="card-header">
                                    <h6><i class="fas fa-hand-holding-usd me-2"></i>Payments</h6>
                                    <span class="badge bg-light text-dark border" v-if="state.paymentList.length">{{ state.paymentList.length }}</span>
                                </div>
                                <div class="card-body">
                                    <p class="text-muted small mb-2" v-if="!state.id">
                                        Add a product to create the order, then record payments here.
                                    </p>

                                    <div class="table-responsive" v-if="state.paymentList.length">
                                        <table class="table table-sm align-middle mb-3">
                                            <thead>
                                                <tr class="text-muted small">
                                                    <th>Date</th>
                                                    <th>Method</th>
                                                    <th class="text-end">Amount</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr v-for="p in state.paymentList" v-bind:key="p.id">
                                                    <td class="small">{{ handler.formatPaymentDate(p.paymentDate) }}</td>
                                                    <td class="small">{{ p.paymentMethodName }}</td>
                                                    <td class="small text-end">{{ handler.formatAmount(p.amount) }}</td>
                                                    <td class="text-end">
                                                        <button type="button"
                                                                class="btn btn-sm btn-link text-danger p-0"
                                                                v-on:click="handler.deletePayment(p)"
                                                                v-bind:disabled="state.deleteMode || state.isPaymentSubmitting"
                                                                title="Remove this payment">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <p class="text-muted small mb-2" v-else-if="state.id">No payments recorded yet.</p>

                                    <div class="border-top pt-3" v-if="!state.deleteMode && state.id">
                                        <div class="row g-3">
                                            <div class="col-6">
                                                <label class="form-label">Date</label>
                                                <input ref="paymentDateRef">
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label">Method</label>
                                                <select class="form-select form-select-sm" v-model="state.newPayment.paymentMethodId">
                                                    <option value="">Select...</option>
                                                    <option v-for="m in state.paymentMethodListLookupData" v-bind:key="m.id" v-bind:value="m.id">{{ m.name }}</option>
                                                </select>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label">Amount Paid</label>
                                                <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                                                       v-model.number="state.newPayment.amount"
                                                       v-bind:placeholder="handler.formatAmount(state.paymentSummary ? state.paymentSummary.amountOutstanding : 0)">
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label">Reference</label>
                                                <input type="text" class="form-control form-control-sm" v-model="state.newPayment.referenceNumber" placeholder="Optional">
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 mt-3">
                                            <button type="button" class="btn btn-sm btn-success"
                                                    v-on:click="handler.submitPayment"
                                                    v-bind:disabled="state.isPaymentSubmitting || state.isFullySettled">
                                                <span class="spinner-border spinner-border-sm me-1" v-if="state.isPaymentSubmitting" role="status" aria-hidden="true"></span>
                                                <i class="fas fa-plus me-2" v-else></i>Record Payment
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    v-on:click="handler.payFullBalance"
                                                    v-bind:disabled="state.isPaymentSubmitting || state.isFullySettled"
                                                    title="Fill the amount with the outstanding balance">
                                                Pay full balance
                                            </button>
                                        </div>
                                        <div class="text-danger small mt-2" v-if="state.paymentError">{{ state.paymentError }}</div>
                                        <div class="text-success small mt-2" v-if="state.isFullySettled">This order is fully settled.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-2"></i>Close</button>
                    <button type="button"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                        <i v-if="!state.isSubmitting" v-bind:class="state.deleteMode ? 'fas fa-trash me-2' : 'fas fa-save me-2'"></i><span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Delete Order' : 'Save Order Details' }}</span>
                        <span v-else>{{ state.deleteMode ? 'Deleting...' : 'Saving...' }}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Customer Quick Create Modal -->
    <div class="modal fade" ref="customerQuickModalRef" id="CustomerQuickModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-user-plus me-2"></i>Quick Create Customer</h5>
                    <button type="button" class="btn-close" v-on:click="handler.closeCustomerQuickCreate" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3"><i class="fas fa-info-circle me-2"></i>Fill in the required fields. The new customer will be automatically selected after creation.</p>
                    <div class="card mb-3">
                        <div class="card-header"><h6 class="mb-0"><i class="fas fa-info-circle me-2 text-primary"></i>Basic Info</h6></div>
                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <label>Name <span class="text-danger">*</span></label>
                                    <input v-model="state.customerQuickName" type="text" class="form-control" placeholder="Customer name" />
                                    <span class="text-danger small">{{ state.customerQuickErrors.name }}</span>
                                </div>
                                <div class="col-md-6">
                                    <label>Description</label>
                                    <input v-model="state.customerQuickDescription" type="text" class="form-control" placeholder="Optional" />
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <label>Customer Group <span class="text-danger">*</span></label>
                                    <div class="d-flex align-items-center gap-2">
                                        <div ref="customerQuickGroupIdRef" class="flex-grow-1"></div>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-success flex-shrink-0"
                                                v-on:click="handler.openCustomerGroupQuickCreate"
                                                title="Quick-create a new customer group">
                                            <i class="fas fa-plus me-2"></i>New
                                        </button>
                                    </div>
                                    <span class="text-danger small">{{ state.customerQuickErrors.customerGroupId }}</span>
                                </div>
                                <div class="col-md-6">
                                    <label>Customer Category <span class="text-danger">*</span></label>
                                    <div class="d-flex align-items-center gap-2">
                                        <div ref="customerQuickCategoryIdRef" class="flex-grow-1"></div>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-warning flex-shrink-0"
                                                v-on:click="handler.openCustomerCategoryQuickCreate"
                                                title="Quick-create a new customer category">
                                            <i class="fas fa-plus me-2"></i>New
                                        </button>
                                    </div>
                                    <span class="text-danger small">{{ state.customerQuickErrors.customerCategoryId }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card mb-3">
                        <div class="card-header"><h6 class="mb-0"><i class="fas fa-map-marker-alt me-2 text-primary"></i>Address</h6></div>
                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col-md-12">
                                    <label>Street <span class="text-danger">*</span></label>
                                    <input v-model="state.customerQuickStreet" type="text" class="form-control" placeholder="Street address" />
                                    <span class="text-danger small">{{ state.customerQuickErrors.street }}</span>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-4">
                                    <label>City <span class="text-danger">*</span></label>
                                    <input v-model="state.customerQuickCity" type="text" class="form-control" placeholder="City" />
                                    <span class="text-danger small">{{ state.customerQuickErrors.city }}</span>
                                </div>
                                <div class="col-md-4">
                                    <label>State / Province <span class="text-danger">*</span></label>
                                    <input v-model="state.customerQuickAddrState" type="text" class="form-control" placeholder="State / Province" />
                                    <span class="text-danger small">{{ state.customerQuickErrors.addrState }}</span>
                                </div>
                                <div class="col-md-4">
                                    <label>Zip Code <span class="text-danger">*</span></label>
                                    <input v-model="state.customerQuickZipCode" type="text" class="form-control" placeholder="Zip / Postal code" />
                                    <span class="text-danger small">{{ state.customerQuickErrors.zipCode }}</span>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-12">
                                    <label>Country</label>
                                    <input v-model="state.customerQuickCountry" type="text" class="form-control" placeholder="Country (optional)" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-header"><h6 class="mb-0"><i class="fas fa-phone me-2 text-primary"></i>Contact</h6></div>
                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col-md-6">
                                    <label>Phone Number <span class="text-danger">*</span></label>
                                    <input v-model="state.customerQuickPhoneNumber" type="text" class="form-control" placeholder="Phone number" />
                                    <span class="text-danger small">{{ state.customerQuickErrors.phoneNumber }}</span>
                                </div>
                                <div class="col-md-6">
                                    <label>Email Address <span class="text-danger">*</span></label>
                                    <input v-model="state.customerQuickEmailAddress" type="email" class="form-control" placeholder="Email address" />
                                    <span class="text-danger small">{{ state.customerQuickErrors.emailAddress }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" v-on:click="handler.closeCustomerQuickCreate"><i class="fas fa-times me-2"></i>Cancel</button>
                    <button type="button" class="btn btn-primary" v-on:click="handler.submitCustomerQuickCreate" v-bind:disabled="state.customerQuickIsSubmitting">
                        <span class="spinner-border spinner-border-sm me-1" v-if="state.customerQuickIsSubmitting"></span>
                        <i class="fas fa-user-plus me-2" v-else></i>
                        {{ state.customerQuickIsSubmitting ? 'Creating...' : 'Create & Select' }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- CustomerGroup Quick Create Modal -->
    <div class="modal fade" ref="customerGroupQuickModalRef" id="CustomerGroupQuickModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="fas fa-users me-2"></i>Quick Create Customer Group</h5>
