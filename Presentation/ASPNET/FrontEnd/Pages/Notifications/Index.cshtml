@page
@{
    ViewData["Title"] = "Notifications";
}

@section styles {
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
}

<div id="app" v-cloak>
    <div class="form-card" id="formcard">
        <div class="container-fluid py-4 px-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">
                        <i class="fas fa-bell me-2"></i>Notifications
                        <span class="badge badge-primary ms-2" v-if="state.unreadCount > 0">{{ state.unreadCount }} unread</span>
                    </h3>
                    <div>
                        <button class="btn btn-sm btn-outline-secondary me-2" v-on:click="methods.refresh" v-bind:disabled="state.isLoading">
                            <i class="fas fa-sync-alt"></i> Refresh
                        </button>
                        <button class="btn btn-sm btn-primary" v-on:click="methods.markAllRead" v-bind:disabled="state.unreadCount === 0">
                            <i class="fas fa-check-double"></i> Mark all as read
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="btn-group mb-3" role="group">
                        <button type="button" class="btn btn-sm"
                                v-bind:class="state.onlyUnread ? 'btn-outline-secondary' : 'btn-secondary'"
                                v-on:click="methods.setFilter(false)">All</button>
                        <button type="button" class="btn btn-sm"
                                v-bind:class="state.onlyUnread ? 'btn-secondary' : 'btn-outline-secondary'"
                                v-on:click="methods.setFilter(true)">Unread</button>
                        <span class="ms-2 align-self-center text-muted" v-if="state.isLive">
                            <i class="fas fa-circle text-success"></i> Live
                        </span>
                        <span class="ms-2 align-self-center text-muted" v-else>
                            <i class="fas fa-circle text-warning"></i> Polling
                        </span>
                    </div>

                    <div class="alert alert-danger" v-if="state.loadError">
                        <i class="fas fa-exclamation-triangle me-2"></i>{{ state.loadError }}
                    </div>

                    <div class="text-center text-muted py-3" v-if="state.isLoading">
                        <i class="fas fa-spinner fa-spin me-2"></i>Loading…
                    </div>

                    <div v-else>
                        <div v-for="n in state.items" v-bind:key="n.id"
                             class="notification-page-item"
                             v-bind:class="{ 'notification-page-item--unread': !n.isRead }"
                             v-on:click="methods.open(n)">
                            <span class="notification-page-item--unread-dot" v-if="!n.isRead"></span>
                            <span class="notification-page-icon" v-bind:style="{ color: methods.severityColor(n.severity) }">
                                <i v-bind:class="methods.severityIcon(n.severity)"></i>
                            </span>
                            <span class="notification-page-body">
                                <div class="notification-page-title">{{ n.title }}</div>
                                <div class="notification-page-message" v-if="n.message">{{ n.message }}</div>
                                <div class="notification-page-time">{{ methods.timeAgo(n.createdAtUtc) }}</div>
                            </span>
                            <button class="btn btn-sm btn-outline-danger notification-page-delete"
                                    title="Delete"
                                    v-on:click.stop="methods.remove(n)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                        <div class="text-center text-muted py-4" v-if="state.items.length === 0">
                            <i class="fas fa-bell-slash fa-2x mb-2"></i>
                            <div>You are all caught up.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Notifications/Index.cshtml.js"></script>
}
