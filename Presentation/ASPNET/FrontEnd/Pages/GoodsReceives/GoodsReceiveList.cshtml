@page
@{
    ViewData["Title"] = "Goods Receive List";
}

@section styles {
    <link rel="stylesheet" href="~/css/purchase-order-list.css" asp-append-version="true" />
}

<div id="app" v-cloak>
    <div class="po-page-header">
        <h1 class="po-page-title">Goods Receives</h1>
        <p class="po-page-subtitle">Review, filter, and manage every goods receive</p>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="grid-container po-grid-wrap">
                <!-- Filter panel — toggled by the Filter button in the grid toolbar. Live filtering:
                     each control change re-filters the list instantly (no Apply button needed). -->
                <div ref="filterPanelRef" class="po-filter-panel" v-show="state.filterOpen" role="region" aria-label="Goods receive filters">
                    <div class="po-filter-panel__header">
                        <span class="po-filter-panel__title">
                            <i class="fas fa-filter"></i>Filters
                            <span class="po-filter-panel__count" v-if="activeFilterCount">{{ activeFilterCount }}</span>
                        </span>
                        <div class="po-filter-panel__header-actions">
                            <button type="button" class="btn btn-sm btn-link po-filter-clear" v-on:click="handler.clearFilters" v-bind:disabled="!activeFilterCount">
                                <i class="fas fa-times-circle"></i><span>Clear all</span>
                            </button>
                            <button type="button" class="btn-close po-filter-close" aria-label="Close filters" v-on:click="handler.toggleFilter"></button>
                        </div>
                    </div>
                    <div class="po-filter-panel__body">
                        <div class="po-filter-field">
                            <label class="po-filter-label">Status</label>
                            <div ref="filterStatusRef"></div>
                        </div>
                        <div class="po-filter-field">
                            <label class="po-filter-label">Receiving Status</label>
                            <div ref="filterReceivingStatusRef"></div>
                        </div>
                        <div class="po-filter-field">
                            <label class="po-filter-label">Receive From</label>
                            <div ref="filterFromDateRef"></div>
                        </div>
                        <div class="po-filter-field">
                            <label class="po-filter-label">Receive To</label>
                            <div ref="filterToDateRef"></div>
                        </div>
                    </div>
                </div>

                <div ref="mainGridRef" id="MainGrid"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" v-model="state.id" id="Id" name="Id" />
                    <form>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5><i class="fas fa-info-circle me-2 text-primary"></i>Main Info</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="ReceiveDate">Receive Date</label>
                                                <input ref="receiveDateRef">
                                                <label class="text-danger">{{ state.errors.receiveDate }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="Number">Number</label>
                                                <input ref="numberRef" v-model="state.number" readonly>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="PurchaseOrderId">Purchase Order</label>
                                                <div ref="purchaseOrderIdRef"></div>
                                                <label class="text-danger">{{ state.errors.purchaseOrderId }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="Status">Status</label>
                                                <div ref="statusRef"></div>
                                                <label class="text-danger">{{ state.errors.status }}</label>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-12">
                                                <label for="Description">Description</label>
                                                <textarea class="form-control" rows="3" v-model="state.description"></textarea>
                                                <label class="text-danger">{{ state.errors.description }}</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    <div id="ComplexDiv" :style="{ display: state.showComplexDiv ? 'block' : 'none' }">
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5><i class="fas fa-boxes me-2 text-primary"></i>Receive Item</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="grid-container">
                                                    <div ref="secondaryGridRef" id="SecondaryGrid"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4">
                            <div class="col-md-12">
                                <div class="card shadow-sm">
                                    <div class="card-header text-white">
                                        <h5 class="mb-0"><i class="fas fa-calculator me-2 text-success"></i>Summary</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row justify-content-end">
                                            <div class="col-md-6">
                                                <div class="d-flex justify-content-between py-2">
                                                    <span class="fw-bold">Total Movement</span>
                                                    <span id="TotalMovement" class="fw-bold text-success">{{ state.totalMovementFormatted }}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-2"></i>Close</button>
                    <button type="button"
                            id="MainSaveButton"
                            class="btn"
                            v-if="!state.isNewlyCreated"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                        <i v-if="!state.isSubmitting" v-bind:class="state.deleteMode ? 'fas fa-trash me-2' : 'fas fa-save me-2'"></i><span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Delete' : 'Save' }}</span>
                        <span v-else>{{ state.deleteMode ? 'Deleting...' : 'Saving...' }}</span>
                    </button>
                    <button type="button"
                            class="btn btn-success"
                            v-if="state.isNewlyCreated"
                            v-on:click="handler.handleSubmitClose">
                        <i class="fas fa-check me-2"></i>Submit
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/GoodsReceives/GoodsReceiveList.cshtml.js"></script>
}