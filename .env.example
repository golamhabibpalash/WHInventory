# Copy to .env and fill in real values. .env is gitignored; never commit real secrets.
# Consumed by docker-compose.yml.

# -- Database -------------------------------------------------------------------
DB_NAME=ustock
DB_USER=ustock
DB_PASSWORD=change-me-strong-db-password

# -- Application secrets --------------------------------------------------------
# The app refuses to start in Production while these hold the repo's placeholder
# values (enforced by GuardProductionSecrets in BackEndConfiguration).

# JWT signing key (HS256). MUST be unique per deployment and >= 32 characters.
# Generate one, e.g.:  openssl rand -base64 48
JWT_KEY=change-me-to-a-unique-random-key-at-least-32-chars

# Initial password for the seeded default admin (admin@root.com). Change after first login.
ADMIN_PASSWORD=change-me-strong-admin-password

# -- Cloudflare Tunnel ----------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
